}
.know-body { font-size: 13px; color: var(--ink-soft); line-height: 1.8; margin-bottom: 14px; }
.know-steps {
  list-style: none; padding-left: 0; margin-top: 16px;
}
.know-steps li {
  font-size: 12px; color: var(--ink-soft); line-height: 1.7;
  padding-left: 20px; position: relative; margin-bottom: 8px;
}
.know-steps li::before {
  content: '→'; position: absolute; left: 0; color: var(--gold);
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .raasi-intro-grid { grid-template-columns: 1fr; }
  .raasi-cards-grid { grid-template-columns: 1fr 1fr; }
