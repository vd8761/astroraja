<style>
/* ── RAASI INTRO ── */
.raasi-intro-section { padding: 96px 6%; }
.raasi-intro-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 72px;
  align-items: start; margin-top: 56px;
}
.raasi-diagram {
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 48px;
  box-shadow: var(--shadow-soft);
}
.raasi-chart-svg {
  width: 100%; height: auto;
}
.raasi-intro-body { font-size: 14px; color: var(--ink-soft); line-height: 1.9; margin-bottom: 18px; }
.raasi-intro-highlight {
  background: var(--gold-faint); border-left: 3px solid var(--gold);
  padding: 20px 24px; border-radius: 3px; margin: 28px 0;
}
.raasi-intro-highlight-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 18px; font-weight: 600; color: var(--ink); margin-bottom: 8px;
}
.raasi-intro-highlight-text { font-size: 13px; color: var(--ink-soft); line-height: 1.75; }

/* ── ALL 12 RAASIS ── */
.all-raasis-section {
  padding: 96px 6%;
  background: var(--gold-faint);
  border-top: 1px solid var(--cream-border);
  border-bottom: 1px solid var(--cream-border);
}
.raasi-cards-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 20px; margin-top: 56px;
}
.raasi-card {
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 32px 28px;
  transition: all 0.2s; cursor: pointer; text-decoration: none; display: block;
}
.raasi-card:hover { box-shadow: var(--shadow-soft); border-color: var(--gold); }
.rc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.rc-symbol { font-size: 38px; }
.rc-tag {
  background: var(--gold-faint); border: 1px solid var(--cream-border);
  border-radius: 100px; padding: 3px 11px;
  font-size: 10px; color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em;
}
.rc-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 26px; font-weight: 600; color: var(--ink); margin-bottom: 4px;
}
.rc-tamil { font-size: 14px; color: var(--ink-soft); margin-bottom: 16px; }
.rc-dates { font-size: 11px; color: var(--gold); margin-bottom: 18px; letter-spacing: 0.04em; }
.rc-desc { font-size: 13px; color: var(--ink-soft); line-height: 1.75; margin-bottom: 16px; }
.rc-traits { display: flex; flex-wrap: wrap; gap: 6px; }
.rc-trait {
  background: var(--gold-faint); border: 1px solid var(--cream-border);
  border-radius: 100px; padding: 3px 10px; font-size: 10px; color: var(--ink-mid);
}

/* ── LAGNAM SECTION ── */
.lagnam-section { padding: 96px 6%; }
.lagnam-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 64px;
  align-items: start; margin-top: 56px;
}
.lagnam-desc { font-size: 14px; color: var(--ink-soft); line-height: 1.9; margin-bottom: 18px; }
.lagnam-importance {
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 32px;
}
.lagnam-imp-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-weight: 600; color: var(--ink); margin-bottom: 18px;
}
.lagnam-points { list-style: none; }
.lagnam-points li {
  display: flex; align-items: flex-start; gap: 14px;
  font-size: 13px; color: var(--ink-soft); line-height: 1.75;
  padding: 14px 0; border-bottom: 1px solid var(--cream-border);
}
.lagnam-points li:last-child { border-bottom: none; }
.lagnam-points li::before {
  content: '✦'; color: var(--gold); font-size: 10px; margin-top: 3px; flex-shrink: 0;
}

/* ── NAKSHATRA SECTION ── */
.nakshatra-section {
  padding: 96px 6%;
  background: var(--ink);
}
.nakshatra-intro {
  max-width: 680px; margin-bottom: 56px;
}
.nak-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
  background: rgba(254,250,243,0.08); border: 1px solid rgba(254,250,243,0.08);
  border-radius: 3px; overflow: hidden;
}
.nak-card {
  background: rgba(254,250,243,0.03);
  border: 1px solid rgba(254,250,243,0.08);
  padding: 24px 20px;
  transition: all 0.2s;
}
.nak-card:hover {
  background: rgba(200,148,26,0.12);
  border-color: rgba(200,148,26,0.3);
}
.nak-num {
  font-size: 10px; color: rgba(200,148,26,0.6);
  text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;
}
.nak-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px; font-weight: 600; color: var(--cream); margin-bottom: 5px;
}
.nak-tamil { font-size: 12px; color: rgba(254,250,243,0.4); margin-bottom: 12px; }
.nak-ruler { font-size: 11px; color: rgba(200,148,26,0.7); margin-bottom: 10px; }
.nak-essence { font-size: 12px; color: rgba(254,250,243,0.5); line-height: 1.7; }

/* ── KNOWING YOUR DETAILS ── */
.know-details-section {
  padding: 96px 6%;
  border-top: 1px solid var(--cream-border);
}
.know-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;
