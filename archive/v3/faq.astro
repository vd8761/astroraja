<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>FAQ - Ask Astro Raja</title>
<link rel="stylesheet" href="/shared.css"/>
<style>
/* ── FAQ SECTIONS ── */
.faq-section { padding: 96px 6%; }
.faq-categories {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 16px; margin-top: 56px; margin-bottom: 64px;
}
.faq-cat-btn {
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 20px 18px;
  font-family: 'DM Sans', sans-serif;
  font-size: 12px; font-weight: 500; letter-spacing: 0.06em;
  color: var(--ink-soft); cursor: pointer; transition: all 0.2s;
  text-align: center;
}
.faq-cat-btn:hover, .faq-cat-btn.active {
  background: var(--gold); color: var(--white); border-color: var(--gold);
}

.faq-list { max-width: 860px; margin: 0 auto; }
.faq-item {
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; margin-bottom: 16px; overflow: hidden;
  transition: all 0.2s;
}
.faq-item:hover { border-color: var(--gold); }
.faq-q-wrap {
  padding: 24px 28px; cursor: pointer; display: flex;
  justify-content: space-between; align-items: center;
}
.faq-q {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px; font-weight: 600; color: var(--ink);
  flex: 1;
}
.faq-toggle {
  width: 28px; height: 28px; flex-shrink: 0;
  background: var(--gold-faint); border: 1px solid var(--cream-border);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 16px; color: var(--gold); transition: all 0.2s;
}
.faq-item.open .faq-toggle { transform: rotate(45deg); background: var(--gold); color: var(--white); }
.faq-a-wrap {
  max-height: 0; overflow: hidden;
  transition: max-height 0.3s ease;
}
.faq-item.open .faq-a-wrap { max-height: 600px; }
.faq-a {
  padding: 0 28px 28px;
  font-size: 14px; color: var(--ink-soft); line-height: 1.85;
}
.faq-a p { margin-bottom: 14px; }
.faq-a p:last-child { margin-bottom: 0; }
.faq-a strong { color: var(--ink); font-weight: 500; }

/* ── STILL HAVE QUESTIONS ── */
.contact-cta-section {
  padding: 96px 6%;
  background: var(--gold-faint);
  border-top: 1px solid var(--cream-border);
  border-bottom: 1px solid var(--cream-border);
  text-align: center;
}
.contact-cta-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(36px, 4.5vw, 56px); font-weight: 300;
  line-height: 1.12; color: var(--ink); margin-bottom: 16px;
}
.contact-cta-title em { font-style: italic; color: var(--gold); }
.contact-cta-sub { font-size: 15px; color: var(--ink-soft); margin-bottom: 36px; line-height: 1.7; }
.contact-methods {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  max-width: 780px; margin: 0 auto;
}
.contact-card {
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 32px 24px; text-align: center;
}
.contact-icon { font-size: 28px; margin-bottom: 14px; display: block; }
.contact-method-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 19px; font-weight: 600; color: var(--ink); margin-bottom: 10px;
}
.contact-method-text { font-size: 13px; color: var(--ink-soft); line-height: 1.7; }
.contact-link {
  display: inline-block; margin-top: 14px;
  font-size: 12px; font-weight: 500; letter-spacing: 0.06em;
  color: var(--gold); text-decoration: none; text-transform: uppercase;
  border-bottom: 1px solid var(--gold); padding-bottom: 2px;
  transition: color 0.2s;
}
.contact-link:hover { color: var(--ink); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .faq-categories { grid-template-columns: repeat(2, 1fr); }
  .contact-methods { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .faq-categories { grid-template-columns: 1fr; }
}
</style>
</head>
