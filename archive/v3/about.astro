---
// Version 3 (Original Claude HTML)
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>About - Ask Astro Raja</title>
<link rel="stylesheet" href="/shared.css"/>
<style>
.mission-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
  align-items: start; padding: 96px 6%;
}
.mission-img-wrap {
  position: relative;
}
.mission-img-main {
  width: 100%; height: 500px; object-fit: cover; object-position: top center;
  border-radius: 3px; box-shadow: var(--shadow-gold); display: block;
}
.mission-img-accent {
  position: absolute; bottom: -28px; right: -28px;
  width: 52%; height: 220px; object-fit: cover; object-position: top center;
  border-radius: 3px; border: 5px solid var(--cream); box-shadow: var(--shadow-soft);
}
.mission-label {
  font-size: 10px; font-weight: 500; letter-spacing: 0.14em;
  color: var(--gold); text-transform: uppercase; margin-bottom: 14px;
}
.mission-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(36px, 4vw, 52px); font-weight: 400;
  line-height: 1.12; color: var(--ink); margin-bottom: 28px;
}
.mission-title em { font-style: italic; color: var(--gold); }
.mission-body {
  font-size: 15px; color: var(--ink-soft); line-height: 1.9; margin-bottom: 20px;
}
.mission-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-style: italic; font-weight: 300;
  color: var(--ink-mid); line-height: 1.6;
  border-left: 2px solid var(--gold); padding-left: 24px;
  margin: 36px 0;
}

/* ── VALUES ── */
.values-section {
  padding: 96px 6%;
  background: var(--gold-faint);
  border-top: 1px solid var(--cream-border);
  border-bottom: 1px solid var(--cream-border);
}
.values-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 2px; background: var(--cream-border);
  border: 1px solid var(--cream-border); border-radius: 3px;
  overflow: hidden; margin-top: 56px;
}
.value-card {
  background: var(--white); padding: 40px 32px;
}
.value-icon {
  font-size: 28px; margin-bottom: 18px; display: block;
}
.value-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-weight: 600; color: var(--ink); margin-bottom: 12px;
}
.value-desc { font-size: 13px; color: var(--ink-soft); line-height: 1.8; }

/* ── WHO IT'S FOR ── */
.audience-section { padding: 96px 6%; }
.audience-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
  margin-top: 56px;
}
.audience-card {
  display: grid; grid-template-columns: auto 1fr; gap: 24px;
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 32px 28px; align-items: start;
}
.audience-avatar {
  width: 72px; height: 80px; object-fit: cover; object-position: top center;
  border-radius: 3px; flex-shrink: 0;
}
.audience-role {
  font-size: 10px; font-weight: 500; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--gold); margin-bottom: 8px;
}
.audience-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px; font-weight: 600; color: var(--ink); margin-bottom: 10px;
}
.audience-desc { font-size: 13px; color: var(--ink-soft); line-height: 1.75; }

/* ── AI SECTION ── */
.ai-section {
  padding: 96px 6%;
  background: var(--ink);
}
.ai-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
}
.ai-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(36px, 4vw, 52px); font-weight: 300;
  line-height: 1.12; color: var(--cream); margin-bottom: 24px;
}
.ai-title em { font-style: italic; color: var(--gold-light); }
.ai-body { font-size: 14px; color: rgba(254,250,243,0.55); line-height: 1.9; margin-bottom: 18px; }
.ai-points { list-style: none; margin-top: 28px; }
.ai-points li {
  display: flex; align-items: flex-start; gap: 14px;
  font-size: 13px; color: rgba(254,250,243,0.55);
  line-height: 1.7; padding: 14px 0;
  border-bottom: 1px solid rgba(254,250,243,0.07);
}
.ai-points li::before {
  content: '✦'; color: var(--gold); font-size: 10px; margin-top: 3px; flex-shrink: 0;
}
.ai-visual {
  background: rgba(254,250,243,0.03);
  border: 1px solid rgba(254,250,243,0.09);
  border-radius: 3px; padding: 40px;
}
.ai-visual-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 17px; font-weight: 600; color: var(--cream); margin-bottom: 24px;
  padding-bottom: 16px; border-bottom: 1px solid rgba(254,250,243,0.09);
}
.ai-flow-step {
  display: flex; align-items: flex-start; gap: 16px;
  padding: 14px 0; border-bottom: 1px solid rgba(254,250,243,0.06);
}
.ai-flow-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-weight: 300; color: var(--gold);
  flex-shrink: 0; line-height: 1; margin-top: 1px;
}
.ai-flow-label { font-size: 12px; color: rgba(254,250,243,0.5); line-height: 1.7; }
.ai-flow-label strong { display: block; color: rgba(254,250,243,0.8); font-size: 13px; margin-bottom: 2px; }

/* ── TEAM ── */
.team-section {
  padding: 96px 6%;
  border-top: 1px solid var(--cream-border);
}
.team-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  margin-top: 56px;
}
.team-card {
  text-align: center;
  border: 1px solid var(--cream-border); border-radius: 3px; padding: 36px 24px;
  background: var(--white);
}
.team-photo {
  width: 96px; height: 104px;
  object-fit: cover; object-position: top center;
  border-radius: 3px; margin: 0 auto 18px;
  display: block; border: 3px solid var(--cream-border);
}
.team-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 21px; font-weight: 600; color: var(--ink); margin-bottom: 4px;
}
.team-role { font-size: 11px; color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 14px; }
.team-bio { font-size: 13px; color: var(--ink-soft); line-height: 1.75; }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .mission-grid { grid-template-columns: 1fr; }
  .mission-img-accent { display: none; }
  .values-grid { grid-template-columns: 1fr; }
  .audience-grid { grid-template-columns: 1fr; }
  .ai-inner { grid-template-columns: 1fr; }
  .team-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .team-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

