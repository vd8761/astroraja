# and throwaway generated PDFs - none of it belongs in the repo.
temp/

# Generated PDFs (reports are produced at runtime, never committed)
/*.pdf
preview_output.pdf

# Python helper-script artifacts (count_pages.py, download_pdf.py, …)
__pycache__/
*.py[cod]
.venv/
venv/

# ───────────────────────── Editors / IDE ────────────────────────
.idea/

# VS Code: keep the shared config, ignore everything else local
.vscode/*

# ───────────────────────── Claude Code ──────────────────────────
.claude/

# ───────────────────────── OS files ─────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
