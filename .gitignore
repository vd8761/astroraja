node_modules/
.pnp
.pnp.js
.npm
.eslintcache

# ───────────────────────── Build / output ───────────────────────
dist/
.astro/
.output/
.vercel/
.turbo/
build/
coverage/

# ───────────────────────── Environment ──────────────────────────
.env
