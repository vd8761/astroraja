---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  basePath?: string;
}

const { 
  title = "Ask Astro Raja | Decode Your Behavioral Blueprint",
  description = "We don't read your stars. We read your patterns. And we give you the system to rewrite them.",
  image = "/images/hero_moon_zodiac_1779193351110.png",
  basePath = ""
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://askastroraja.com');

const homeLink = `${basePath}/`;
const getReadingLink = `${basePath}/get-reading?new=1`;
const sampleLink = `${basePath}/sample-report`;
const howItWorksLink = `${basePath}/how-it-works`;
const manifestoLink = `${basePath}/manifesto`;
const stuckFeelingLink = `${basePath}/the-stuck-feeling`;
const innerWarLink = `${basePath}/the-inner-war`;
const relationshipPainLink = `${basePath}/relationship-pain`;
const moneyCareerLink = `${basePath}/money-career-confusion`;
const invisibleSufferingLink = `${basePath}/invisible-suffering`;
const raasiGuideLink = `${basePath}/raasi-guide`;
const faqLink = `${basePath}/faq`;
const aboutLink = `${basePath}/about`;
const privacyLink = `${basePath}/privacy`;
const termsLink = `${basePath}/terms`;
const contactLink = `${basePath}/contact`;
const currentPath = Astro.url.pathname;
const isActive = (path) => {
  // exact match for home
  if (path === basePath + '/' || path === basePath) {
    return currentPath === path || currentPath === path + '/';
  }
  // startsWith for other pages (like /v2/about)
  return currentPath.startsWith(path);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Canonical -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Razorpay Checkout -->
    <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-brand-light-bg text-brand-text flex flex-col min-h-screen">
    
    <!-- Navigation Bar (Hidden when printing) -->
    <header class="print:hidden sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-brand-border/50 shadow-sm transition-all duration-300 relative">
      <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
        <a href={homeLink} class="flex items-center gap-2 group flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 sm:w-11 sm:h-11 text-brand-saffron group-hover:scale-105 transition-transform duration-500 ease-out" viewBox="0 0 100 100" fill="currentColor">
            <circle cx="38" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="4.5" />
            <circle cx="38" cy="18" r="3.5" />
            <circle cx="38" cy="82" r="3.5" />
            <circle cx="8" cy="50" r="3.5" />
            <path d="M 38 38 Q 38 50 26 50 Q 38 50 38 62 Q 38 50 50 50 Q 38 50 38 38 Z" />
            <path d="M 64 20 C 84 20 94 38 94 50 C 94 62 84 80 64 80 C 76 74 80 62 80 50 C 80 38 76 26 64 20 Z" />
          </svg>
          <span class="text-xl sm:text-2xl font-bold tracking-tight text-brand-navy">Ask Astro Raja</span>
        </a>
        
        <nav class="hidden md:flex items-center gap-6 font-medium text-sm lg:text-base">
          <div class="relative group py-2">
            <button class="flex items-center gap-1 text-brand-text hover:text-brand-saffron transition-colors cursor-pointer">
              The Patterns
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4.5l3 3 3-3"/></svg>
            </button>
            <div class="absolute top-full left-0 mt-0 pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <div class="bg-white border border-brand-border rounded-xl shadow-lg p-2 flex flex-col">
                <a href={stuckFeelingLink} class="px-4 py-2 text-sm text-brand-text hover:bg-slate-50 hover:text-brand-saffron rounded-lg transition-colors">The Stuck Feeling</a>
                <a href={innerWarLink} class="px-4 py-2 text-sm text-brand-text hover:bg-slate-50 hover:text-brand-saffron rounded-lg transition-colors">The Inner War</a>
                <a href={relationshipPainLink} class="px-4 py-2 text-sm text-brand-text hover:bg-slate-50 hover:text-brand-saffron rounded-lg transition-colors">Relationship Pain</a>
                <a href={moneyCareerLink} class="px-4 py-2 text-sm text-brand-text hover:bg-slate-50 hover:text-brand-saffron rounded-lg transition-colors">Money & Career</a>
                <a href={invisibleSufferingLink} class="px-4 py-2 text-sm text-brand-text hover:bg-slate-50 hover:text-brand-saffron rounded-lg transition-colors">The Invisible Suffering</a>
              </div>
            </div>
          </div>
          <a href={howItWorksLink} class={`transition-colors ${isActive(howItWorksLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>How It Works</a>
          <a href={raasiGuideLink} class={`transition-colors ${isActive(raasiGuideLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>Raasi Guide</a>
          <a href={aboutLink} class={`transition-colors ${isActive(aboutLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>About</a>
          <a href={faqLink} class={`transition-colors ${isActive(faqLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>FAQ</a>
          <a href={contactLink} class={`transition-colors ${isActive(contactLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>Contact</a>
        </nav>
        
        <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
          <a href={getReadingLink} class="px-4 sm:px-6 py-2 sm:py-2.5 rounded-full bg-brand-navy text-white font-semibold hover:bg-brand-purple transition-all shadow-md hover:shadow-lg flex items-center gap-1 sm:gap-2 text-xs sm:text-base">
            <span class="hidden sm:inline">Get My Reading</span>
            <span class="sm:hidden">Start</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-brand-navy hover:bg-slate-100 rounded-md transition-colors" aria-label="Toggle Menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-0 w-full bg-white border-b border-brand-border shadow-xl py-4 px-6 flex flex-col gap-4 max-h-[calc(100vh-5rem)] overflow-y-auto">
        <div class="py-2 border-b border-brand-border/30">
          <span class="font-bold text-brand-navy block mb-3 uppercase tracking-widest text-xs">The Patterns</span>
          <div class="pl-4 flex flex-col gap-3">
            <a href={stuckFeelingLink} class="mobile-link text-sm text-brand-text hover:text-brand-saffron">The Stuck Feeling</a>
            <a href={innerWarLink} class="mobile-link text-sm text-brand-text hover:text-brand-saffron">The Inner War</a>
            <a href={relationshipPainLink} class="mobile-link text-sm text-brand-text hover:text-brand-saffron">Relationship Pain</a>
            <a href={moneyCareerLink} class="mobile-link text-sm text-brand-text hover:text-brand-saffron">Money & Career</a>
            <a href={invisibleSufferingLink} class="mobile-link text-sm text-brand-text hover:text-brand-saffron">The Invisible Suffering</a>
          </div>
        </div>
        <a href={howItWorksLink} class={`mobile-link font-medium py-2 border-b border-brand-border/30 ${isActive(howItWorksLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>How It Works</a>
        <a href={raasiGuideLink} class={`mobile-link font-medium py-2 border-b border-brand-border/30 ${isActive(raasiGuideLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>Raasi Guide</a>
        <a href={aboutLink} class={`mobile-link font-medium py-2 border-b border-brand-border/30 ${isActive(aboutLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>About</a>
        <a href={faqLink} class={`mobile-link font-medium py-2 border-b border-brand-border/30 ${isActive(faqLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>FAQ</a>
        <a href={contactLink} class={`mobile-link font-medium py-2 border-b border-brand-border/30 ${isActive(contactLink) ? 'text-brand-saffron' : 'text-brand-text hover:text-brand-saffron'}`}>Contact</a>
      </div>
    </header>

    <!-- Global Problem Awareness Banner -->
    <div class="bg-brand-saffron/10 border-b border-brand-saffron/20 py-3 px-4 text-center">
      <p class="text-brand-navy text-sm md:text-base max-w-5xl mx-auto font-medium">
        <span class="font-bold">Are you facing these problems?</span> Unexplained money blocks, constant relationship friction, or a heavy "stuck" feeling despite trying everything. Your astrological patterns reveal why this is happening. <span class="italic text-brand-saffron-dark font-semibold whitespace-nowrap">"If you could have known about this, imagine how your life could be."</span>
      </p>
    </div>

    <main class="flex-grow">
      <slot />
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Referral Tracking Interception
        const urlParams = new URLSearchParams(window.location.search);
        const refCode = urlParams.get('ref');
        if (refCode && refCode.trim().length > 0) {
          localStorage.setItem('referralCode', refCode.trim().toUpperCase());
        }

        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const links = document.querySelectorAll('.mobile-link');
        
        btn?.addEventListener('click', () => {
          menu?.classList.toggle('hidden');
        });
        
        links.forEach(link => {
          link.addEventListener('click', () => {
            menu?.classList.add('hidden');
          });
        });
      });
    </script>

    <!-- Footer (Hidden when printing) -->
    <footer class="print:hidden border-t border-brand-border/60 bg-white pt-16 pb-8 px-4 mt-auto">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-12 mb-12">
        <div class="col-span-1 md:col-span-1 mb-6 md:mb-0">
          <a href={homeLink} class="flex items-center gap-2 mb-4 group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 sm:w-11 sm:h-11 text-brand-saffron group-hover:scale-105 transition-transform duration-500 ease-out" viewBox="0 0 100 100" fill="currentColor">
              <circle cx="38" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="4.5" />
              <circle cx="38" cy="18" r="3.5" />
              <circle cx="38" cy="82" r="3.5" />
              <circle cx="8" cy="50" r="3.5" />
              <path d="M 38 38 Q 38 50 26 50 Q 38 50 38 62 Q 38 50 50 50 Q 38 50 38 38 Z" />
              <path d="M 64 20 C 84 20 94 38 94 50 C 94 62 84 80 64 80 C 76 74 80 62 80 50 C 80 38 76 26 64 20 Z" />
            </svg>
            <span class="text-xl font-bold tracking-tight text-brand-navy">Ask Astro Raja</span>
          </a>
          <p class="text-brand-text-muted text-sm leading-relaxed">
            AI-powered Vedic astrology guidance for Tamil Nadu and beyond. Rooted in authentic tradition, delivered with modern clarity.
          </p>
        </div>
        
        <div class="col-span-1 md:col-span-3 grid grid-cols-2 sm:grid-cols-3 gap-8">
          <!-- COLUMN 3: Categories -->
          <div>
            <h4 class="text-brand-navy font-bold mb-6 text-sm tracking-widest uppercase">The Patterns</h4>
            <ul class="space-y-4">
              <li>
                <a href={stuckFeelingLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors text-sm">The Stuck Feeling</a>
              </li>
              <li>
                <a href={innerWarLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors text-sm">The Inner War</a>
              </li>
              <li>
                <a href={relationshipPainLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors text-sm">Relationship Pain</a>
              </li>
              <li>
                <a href={moneyCareerLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors text-sm">Money & Career Confusion</a>
              </li>
              <li>
                <a href={invisibleSufferingLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors text-sm">The Invisible Suffering</a>
              </li>
            </ul>
          </div>

          <div>
          <h4 class="font-bold text-brand-navy mb-4">Diagnostics</h4>
          <ul class="space-y-3 text-sm">
            <li><a href={getReadingLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Get Your Reading</a></li>
            <li><a href={manifestoLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">The Manifesto</a></li>
            <li><a href={howItWorksLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Methodology</a></li>
          </ul>
        </div>
        
          <div class="col-span-2 sm:col-span-1">
            <h4 class="font-bold text-brand-navy mb-4">Support & Legal</h4>
            <ul class="space-y-3 text-sm">
              <li><a href={contactLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Contact Us</a></li>
              <li><a href={faqLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">FAQ</a></li>
              <li><a href={privacyLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Privacy Policy</a></li>
              <li><a href={termsLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Terms of Use</a></li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="max-w-6xl mx-auto pt-8 border-t border-brand-border/40 text-center flex flex-col items-center">
        <p class="text-xs text-brand-text-muted/70 max-w-2xl mb-4">
          Disclaimer: Reports are for guidance and reflection only. Not a substitute for professional advice.
        </p>
        <p class="text-sm text-brand-text-muted font-medium mb-1">
          © {new Date().getFullYear()} Ask Astro Raja. All rights reserved.
        </p>
        <p class="text-xs text-brand-saffron/80">Built with care for Tamil Nadu &middot; askastroraja.com</p>
      </div>
    </footer>
    
  </body>
</html>
