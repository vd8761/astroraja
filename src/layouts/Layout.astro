---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Ask Astro Raja | Personalized Vedic Astrology",
  description = "Get a highly personalized, AI-powered Vedic astrology report without endless back-and-forth. Clear guidance based on your Raasi, Lagnam, and current struggles.",
  image = "/images/hero_moon_zodiac_1779193351110.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://askastroraja.com');

const homeLink = '/';
const getReadingLink = '/#form-section';
const sampleLink = '/#sample';
const howItWorksLink = '/how-it-works';
const raasiGuideLink = '/raasi-guide';
const aboutLink = '/about';
const faqLink = '/faq';
const privacyLink = '/privacy';
const termsLink = '/terms';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Canonical -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-brand-light-bg text-brand-text flex flex-col min-h-screen">
    
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-brand-border/50 shadow-sm transition-all duration-300 relative">
      <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
        <a href={homeLink} class="flex items-center gap-2 group flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 sm:w-9 sm:h-9 text-brand-saffron group-hover:rotate-180 transition-transform duration-700 ease-in-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <ellipse cx="12" cy="12" rx="4" ry="10"></ellipse>
            <ellipse cx="12" cy="12" rx="10" ry="4"></ellipse>
            <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
          </svg>
          <span class="text-xl sm:text-2xl font-bold tracking-tight text-brand-navy">Ask Astro Raja</span>
        </a>
        
        <nav class="hidden md:flex items-center gap-8 font-medium">
          <a href={howItWorksLink} class="text-brand-text hover:text-brand-saffron transition-colors">How It Works</a>
          <a href={sampleLink} class="text-brand-text hover:text-brand-saffron transition-colors">Sample Report</a>
          <a href={raasiGuideLink} class="text-brand-text hover:text-brand-saffron transition-colors">Raasi Guide</a>
          <a href={aboutLink} class="text-brand-text hover:text-brand-saffron transition-colors">About</a>
        </nav>
        
        <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
          <a href={getReadingLink} class="px-4 sm:px-6 py-2 sm:py-2.5 rounded-full bg-brand-navy text-white font-semibold hover:bg-brand-purple transition-all shadow-md hover:shadow-lg flex items-center gap-1 sm:gap-2 text-xs sm:text-base">
            <span class="hidden sm:inline">Get My Reading</span>
            <span class="sm:hidden">Start</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-brand-navy hover:bg-slate-100 rounded-md transition-colors" aria-label="Toggle Menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-0 w-full bg-white border-b border-brand-border shadow-xl py-4 px-6 flex flex-col gap-4">
        <a href={howItWorksLink} class="mobile-link text-brand-text hover:text-brand-saffron font-medium py-2 border-b border-brand-border/30">How It Works</a>
        <a href={sampleLink} class="mobile-link text-brand-text hover:text-brand-saffron font-medium py-2 border-b border-brand-border/30">Sample Report</a>
        <a href={raasiGuideLink} class="mobile-link text-brand-text hover:text-brand-saffron font-medium py-2 border-b border-brand-border/30">Raasi Guide</a>
        <a href={aboutLink} class="mobile-link text-brand-text hover:text-brand-saffron font-medium py-2 border-b border-brand-border/30">About</a>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const links = document.querySelectorAll('.mobile-link');
        
        btn?.addEventListener('click', () => {
          menu?.classList.toggle('hidden');
        });
        
        links.forEach(link => {
          link.addEventListener('click', () => {
            menu?.classList.add('hidden');
          });
        });
      });
    </script>

    <!-- Footer -->
    <footer class="border-t border-brand-border/60 bg-white pt-16 pb-8 px-4 mt-auto">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-12 mb-12">
        <div class="col-span-1 md:col-span-1 mb-6 md:mb-0">
          <a href={homeLink} class="flex items-center gap-2 mb-4 group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-brand-saffron group-hover:rotate-180 transition-transform duration-700 ease-in-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <ellipse cx="12" cy="12" rx="4" ry="10"></ellipse>
              <ellipse cx="12" cy="12" rx="10" ry="4"></ellipse>
              <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
            </svg>
            <span class="text-xl font-bold tracking-tight text-brand-navy">Ask Astro Raja</span>
          </a>
          <p class="text-brand-text-muted text-sm leading-relaxed">
            AI-powered Vedic astrology guidance for Tamil Nadu and beyond. Rooted in authentic tradition, delivered with modern clarity.
          </p>
        </div>
        
        <div class="col-span-1 md:col-span-3 grid grid-cols-2 sm:grid-cols-3 gap-8">
          <div>
          <h4 class="font-bold text-brand-navy mb-4">Tool</h4>
          <ul class="space-y-3 text-sm">
            <li><a href={getReadingLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Get Your Reading</a></li>
            <li><a href={sampleLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Sample Report</a></li>
            <li><a href={raasiGuideLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Raasi Guide</a></li>
            <li><a href={howItWorksLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">How It Works</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-bold text-brand-navy mb-4">Company</h4>
          <ul class="space-y-3 text-sm">
            <li><a href={aboutLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">About Astro Raja</a></li>
            <li><a href="mailto:contact@ask-astro-raja.com" class="text-brand-text-muted hover:text-brand-saffron transition-colors">Contact</a></li>
          </ul>
        </div>
        
          <div class="col-span-2 sm:col-span-1">
            <h4 class="font-bold text-brand-navy mb-4">Legal</h4>
            <ul class="space-y-3 text-sm">
              <li><a href={privacyLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Privacy Policy</a></li>
              <li><a href={termsLink} class="text-brand-text-muted hover:text-brand-saffron transition-colors">Terms of Use</a></li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="max-w-6xl mx-auto pt-8 border-t border-brand-border/40 text-center flex flex-col items-center">
        <p class="text-xs text-brand-text-muted/70 max-w-2xl mb-4">
          Disclaimer: Reports are for guidance and reflection only. Not a substitute for professional advice.
        </p>
        <p class="text-sm text-brand-text-muted font-medium mb-1">
          © {new Date().getFullYear()} Ask Astro Raja. All rights reserved.
        </p>
        <p class="text-xs text-brand-saffron/80">Built with care for Tamil Nadu · ask-astro-raja.com</p>
      </div>
    </footer>
    
  </body>
</html>
