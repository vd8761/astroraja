<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Ask Astro Raja — Vedic Guidance Powered by AI</title>
<link rel="stylesheet" href="/shared.css"/>
<style>
/* ── HERO ── */
.hero {
  min-height: 100vh;
  display: grid; grid-template-columns: 1fr 1fr;
  padding-top: 68px; position: relative; overflow: hidden;
}
.hero-left {
  display: flex; flex-direction: column; justify-content: center;
  padding: 80px 6% 80px 8%; position: relative; z-index: 2;
}
.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--gold-faint); border: 1px solid var(--cream-border);
  border-radius: 100px; padding: 5px 16px;
  font-size: 11px; font-weight: 500; letter-spacing: 0.09em;
  color: var(--gold); text-transform: uppercase;
  margin-bottom: 28px; width: fit-content;
}
.hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(52px, 6vw, 84px);
  font-weight: 300; line-height: 1.06; color: var(--ink); margin-bottom: 28px;
}
.hero-title em { font-style: italic; color: var(--gold); }
.hero-sub {
  font-size: 15px; font-weight: 300; color: var(--ink-soft);
  max-width: 420px; line-height: 1.85; margin-bottom: 44px;
}
.hero-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.hero-stats {
  display: flex; gap: 32px; margin-top: 52px;
  padding-top: 32px; border-top: 1px solid var(--cream-border);
}
.stat-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 30px; font-weight: 600; color: var(--ink); line-height: 1;
}
.stat-label { font-size: 11px; color: var(--ink-soft); margin-top: 4px; letter-spacing: 0.03em; }

/* ── HERO RIGHT ── */
.hero-right {
  position: relative; overflow: hidden;
  background: linear-gradient(140deg, #FBF3E2 0%, #F3E4C4 100%);
}
.hero-bg-mandala {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 580px; height: 580px; opacity: 0.055;
}
/* Three image slots */
.img-main {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 290px; height: 400px; object-fit: cover; object-position: top center;
  border-radius: 3px; box-shadow: var(--shadow-gold); z-index: 2;
}
.img-top-right {
  position: absolute; top: 10%; right: 7%;
  width: 140px; height: 175px; object-fit: cover; object-position: top center;
  border-radius: 3px; box-shadow: var(--shadow-soft); z-index: 3;
}
.img-bottom-left {
  position: absolute; bottom: 10%; left: 7%;
  width: 125px; height: 155px; object-fit: cover; object-position: top center;
  border-radius: 3px; box-shadow: var(--shadow-soft); z-index: 3;
}
.hero-floating-card {
  position: absolute; bottom: 10%; right: 5%; z-index: 4;
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 14px 18px;
  box-shadow: var(--shadow-soft); min-width: 170px;
}
.hfc-label { font-size: 10px; color: var(--ink-soft); letter-spacing: 0.07em; text-transform: uppercase; }
.hfc-value {
  font-family: 'Cormorant Garamond', serif;
  font-size: 17px; font-weight: 600; color: var(--gold); margin-top: 3px;
}
.hfc-stars { color: var(--gold-light); font-size: 11px; margin-top: 4px; letter-spacing: 2px; }

/* ── HOW IT WORKS PREVIEW ── */
.steps-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 2px; background: var(--cream-border);
  border: 1px solid var(--cream-border); border-radius: 3px; overflow: hidden;
}
.step-card {
  background: var(--white); padding: 44px 32px; position: relative;
  transition: background 0.2s;
}
.step-card:hover { background: var(--gold-faint); }
.step-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 64px; font-weight: 300; color: var(--gold-pale);
  line-height: 1; margin-bottom: 16px; display: block;
}
.step-icon {
  width: 42px; height: 42px; background: var(--gold-faint);
  border: 1px solid var(--cream-border); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; margin-bottom: 18px;
}
.step-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-weight: 600; color: var(--ink); margin-bottom: 10px;
}
.step-desc { font-size: 13px; color: var(--ink-soft); line-height: 1.8; margin-bottom: 24px; }
.section-readmore-row {
  margin-top: 40px; display: flex; align-items: center; justify-content: flex-end;
}

/* ── TESTIMONIALS ── */
.testimonials-section {
  padding: 96px 6%;
  background: var(--gold-faint);
  border-top: 1px solid var(--cream-border);
  border-bottom: 1px solid var(--cream-border);
}
.testimonials-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 20px; margin-top: 56px;
}
.testimonial-card {
  background: var(--white); border: 1px solid var(--cream-border);
  border-radius: 3px; padding: 32px 28px; position: relative;
}
.t-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: 64px; font-weight: 300; color: var(--gold-pale);
  position: absolute; top: 14px; left: 20px; line-height: 1;
}
.t-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: 17px; font-style: italic; color: var(--ink-mid);
  line-height: 1.75; margin: 28px 0 24px;
}
.t-person { display: flex; align-items: center; gap: 12px; }
.t-avatar {
  width: 46px; height: 46px; border-radius: 50%;
  border: 2px solid var(--cream-border); overflow: hidden; flex-shrink: 0;
  background: var(--gold-pale);
}
.t-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
.t-name { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-weight: 600; color: var(--ink); }
.t-detail { font-size: 11px; color: var(--ink-soft); margin-top: 2px; }
.t-raasi { font-size: 10px; color: var(--gold); margin-top: 2px; font-weight: 500; }

/* ── RAASI PREVIEW ── */
.raasi-dark {
  padding: 80px 6%;
  background: var(--ink);
}
.raasi-grid {
  display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px;
  margin-top: 44px;
}
.raasi-chip {
  background: rgba(254,250,243,0.04);
  border: 1px solid rgba(254,250,243,0.09);
  border-radius: 3px; padding: 14px 10px;
  text-align: center; cursor: pointer; transition: all 0.2s;
  text-decoration: none;
}
.raasi-chip:hover {
  background: rgba(200,148,26,0.14);
  border-color: rgba(200,148,26,0.35);
}
.raasi-symbol { font-size: 20px; margin-bottom: 5px; }
.raasi-name { font-size: 11px; color: rgba(254,250,243,0.65); }
.raasi-tamil { font-size: 9px; color: rgba(200,148,26,0.65); margin-top: 2px; }
.raasi-readmore-row {
  margin-top: 36px; display: flex; justify-content: flex-end;
}
.readmore-light {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 500; letter-spacing: 0.07em;
  color: rgba(254,250,243,0.5); text-decoration: none; text-transform: uppercase;
  border-bottom: 1px solid rgba(254,250,243,0.15);
  padding-bottom: 3px; transition: color 0.2s, border-color 0.2s;
}
.readmore-light:hover { color: var(--gold); border-bottom-color: var(--gold); }
.readmore-light svg { transition: transform 0.2s; }
.readmore-light:hover svg { transform: translateX(4px); }

/* ── ABOUT PREVIEW ── */
.about-preview {
  padding: 96px 6%;
  display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
}
.about-img-stack { position: relative; height: 480px; }
.ab-img-1 {
  position: absolute; top: 0; left: 0;
  width: 64%; height: 360px;
  object-fit: cover; object-position: top center;
  border-radius: 3px; box-shadow: var(--shadow-gold);
}
.ab-img-2 {
  position: absolute; bottom: 0; right: 0;
  width: 52%; height: 270px;
  object-fit: cover; object-position: top center;
  border-radius: 3px; box-shadow: var(--shadow-soft);
  border: 4px solid var(--cream);
}
.about-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-style: italic; font-weight: 300;
  color: var(--ink-mid); line-height: 1.6;
  border-left: 2px solid var(--gold);
  padding-left: 24px; margin: 32px 0;
}
.about-body { font-size: 14px; color: var(--ink-soft); line-height: 1.85; margin-bottom: 24px; }

/* ── FAQ PREVIEW ── */
.faq-preview {
  padding: 96px 6%;
  background: var(--white);
  border-top: 1px solid var(--cream-border);
}
.faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 56px; }
.faq-item {
  border: 1px solid var(--cream-border); border-radius: 3px;
  padding: 28px 28px; background: var(--cream);
  cursor: pointer; transition: all 0.2s;
}
.faq-item:hover { border-color: var(--gold); background: var(--gold-faint); }
.faq-q {
  font-family: 'Cormorant Garamond', serif;
  font-size: 19px; font-weight: 600; color: var(--ink); margin-bottom: 10px;
}
.faq-a { font-size: 13px; color: var(--ink-soft); line-height: 1.75; }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-right { min-height: 400px; }
  .hero-left { padding: 64px 5%; }
  .steps-grid { grid-template-columns: 1fr; }
  .testimonials-grid { grid-template-columns: 1fr; }
  .raasi-grid { grid-template-columns: repeat(4, 1fr); }
  .about-preview { grid-template-columns: 1fr; }
  .about-img-stack { height: 300px; margin-bottom: 20px; }
  .faq-grid { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .raasi-grid { grid-template-columns: repeat(3, 1fr); }
  .hero-stats { flex-wrap: wrap; gap: 20px; }
}
</style>
</head>
