---
import Layout from '../../layouts/Layout.astro';
---

<Layout basePath="/v1" 
  title="Contact Us | Ask Astro Raja"
  description="Get in touch with Ask Astro Raja for spiritual guidance, support, or inquiries regarding your personalized Vedic astrology report."
>
  
  <section class="py-24 px-4 bg-brand-light-bg relative overflow-hidden border-b border-brand-border/50">
    <div class="max-w-4xl mx-auto relative z-10 text-center">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-4 text-sm">Reach Out</div>
      <h1 class="text-5xl md:text-6xl font-bold leading-[1.1] mb-6 text-brand-navy">
        We Are Here For <span class="gradient-text-light">You.</span>
      </h1>
      <p class="text-xl text-brand-text max-w-2xl mx-auto leading-relaxed">
        Whether you have questions about your Raasi, need help with your personalized report, or simply want to share your journey, our doors are open.
      </p>
    </div>
  </section>

  <section class="py-20 px-4 bg-white relative">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">
      
      <!-- Contact Info -->
      <div>
        <h2 class="text-3xl font-bold text-brand-navy mb-8">Get In Touch</h2>
        <p class="text-brand-text text-lg mb-10 leading-relaxed">
          At Ask Astro Raja, we believe in supporting your spiritual and personal growth. Please reach out using the form, or email us directly. We strive to respond to all seekers within 24-48 hours.
        </p>
        
        <div class="space-y-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-brand-light-bg flex items-center justify-center text-brand-saffron-dark shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-brand-navy text-lg mb-1">Phone Support</h3>
              <p class="text-brand-text-muted">+91 9094496385</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-brand-light-bg flex items-center justify-center text-brand-saffron-dark shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-brand-navy text-lg mb-1">Email Us</h3>
              <a href="mailto:mohan@touchmarkdes.com" class="text-brand-purple hover:underline">mohan@touchmarkdes.com</a>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-brand-light-bg flex items-center justify-center text-brand-saffron-dark shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-brand-navy text-lg mb-1">Headquarters</h3>
              <p class="text-brand-text-muted">Chennai, Tamil Nadu, India</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="bg-white border-0 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] rounded-[2rem] p-8 border border-brand-border/30">
        <h3 class="text-2xl font-bold text-brand-navy mb-6">Send a Message</h3>
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Message sent successfully. We will get back to you soon!');">
          <div class="space-y-2">
            <label for="name" class="block text-sm font-semibold text-brand-navy">Full Name</label>
            <input type="text" id="name" required class="w-full bg-slate-50 border border-brand-border rounded-xl px-4 py-3 text-brand-navy focus:outline-none focus:ring-2 focus:ring-brand-saffron transition-all" />
          </div>
          
          <div class="space-y-2">
            <label for="email" class="block text-sm font-semibold text-brand-navy">Email Address</label>
            <input type="email" id="email" required class="w-full bg-slate-50 border border-brand-border rounded-xl px-4 py-3 text-brand-navy focus:outline-none focus:ring-2 focus:ring-brand-saffron transition-all" />
          </div>
          
          <div class="space-y-2">
            <label for="message" class="block text-sm font-semibold text-brand-navy">Your Message</label>
            <textarea id="message" rows="5" required class="w-full bg-slate-50 border border-brand-border rounded-xl px-4 py-3 text-brand-navy focus:outline-none focus:ring-2 focus:ring-brand-saffron transition-all resize-none"></textarea>
          </div>
          
          <button type="submit" class="w-full py-4 rounded-xl bg-brand-navy text-white font-bold text-lg hover:shadow-lg transition-all flex justify-center items-center gap-2">
            Send Message
          </button>
        </form>
      </div>
      
    </div>
  </section>

</Layout>
