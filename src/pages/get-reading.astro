---
import Layout from '../layouts/Layout.astro';
---

<Layout basePath="" title="Get Your Reading — Ask Astro Raja">
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <div class="max-w-4xl mx-auto py-12 px-4" x-data="readingForm()">
    
    <!-- Progress Indicator -->
    <div class="mb-12" x-show="step < 5 && !isComplete">
      <div class="flex items-center justify-between text-xs font-semibold text-brand-saffron-dark uppercase tracking-wider mb-3">
        <span x-text="`Step ${step + 1} of 6 — ${stepLabels[step]}`"></span>
        <span x-text="`${Math.round(((step + 1) / 6) * 100)}%`"></span>
      </div>
      <div class="h-2 bg-brand-border/50 rounded-full overflow-hidden">
        <div class="h-full bg-brand-saffron transition-all duration-500 ease-out" :style="`width: ${((step + 1) / 6) * 100}%`"></div>
      </div>
    </div>

    <!-- Step 1: Details -->
    <div x-show="step === 0 && !isComplete" x-transition.opacity.duration.300ms>
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-2 text-xs">Step 1 of 6</div>
      <h2 class="text-4xl font-bold text-brand-navy mb-4">Your base <span class="text-brand-saffron italic">parameters</span></h2>
      <p class="text-brand-text-muted mb-8 leading-relaxed max-w-2xl">Enter your Vedic birth details. These three — Raasi, Lagnam, and Nakshatra — are the foundation of your entire reading.</p>

      <div class="space-y-6">
        <div>
          <label class="block text-xs font-bold text-brand-navy uppercase tracking-wider mb-2">Full Name <span class="text-brand-saffron">*</span></label>
          <input type="text" x-model="formData.name" placeholder="e.g. Priya Nandakumar" class="w-full p-4 bg-white border border-brand-border rounded-xl focus:border-brand-saffron focus:ring-2 focus:ring-brand-saffron/20 outline-none transition-all" :class="{'border-red-500': errors.name}">
          <p x-show="errors.name" class="text-red-500 text-xs mt-1">Please enter your name.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold text-brand-navy uppercase tracking-wider mb-2">Email ID <span class="text-brand-saffron">*</span></label>
            <input type="email" x-model="formData.email" placeholder="e.g. priya@example.com" class="w-full p-4 bg-white border border-brand-border rounded-xl focus:border-brand-saffron focus:ring-2 focus:ring-brand-saffron/20 outline-none transition-all" :class="{'border-red-500': errors.email}">
            <p x-show="errors.email" class="text-red-500 text-xs mt-1">Please enter a valid email address.</p>
          </div>
          <div>
            <label class="block text-xs font-bold text-brand-navy uppercase tracking-wider mb-2">Mobile Number <span class="text-brand-saffron">*</span></label>
            <div class="flex gap-2">
              <div class="relative w-32" @click.away="countryOpen = false">
                <button type="button" @click="countryOpen = !countryOpen" class="w-full h-full p-4 bg-white border border-brand-border rounded-xl focus:border-brand-saffron focus:ring-2 focus:ring-brand-saffron/20 outline-none transition-all flex items-center justify-between" :class="{'border-red-500': errors.mobile}">
                  <span x-text="formData.countryCode"></span>
                  <svg class="w-4 h-4 text-brand-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div x-show="countryOpen" style="display: none;" class="absolute z-50 w-72 mt-1 bg-white border border-brand-border rounded-xl shadow-2xl overflow-hidden max-h-72 flex flex-col left-0">
                  <div class="p-2 border-b border-brand-border sticky top-0 bg-white">
                    <input type="text" x-model="countrySearch" placeholder="Search country or code..." class="w-full p-2.5 text-sm bg-slate-50 border border-brand-border rounded-lg outline-none focus:border-brand-saffron focus:ring-1 focus:ring-brand-saffron/30 transition-all">
                  </div>
                  <div class="overflow-y-auto flex-1">
                    <template x-for="c in filteredCountries" :key="c.name">
                      <button type="button" @click="selectCountry(c.code)" class="w-full text-left px-4 py-2.5 text-sm hover:bg-brand-saffron/10 outline-none flex justify-between items-center transition-colors">
                        <span x-text="c.name" class="font-medium text-brand-navy truncate mr-2"></span>
                        <span class="text-brand-text-muted text-xs whitespace-nowrap" x-text="c.code"></span>
                      </button>
                    </template>
                    <div x-show="filteredCountries.length === 0" class="p-4 text-sm text-center text-brand-text-muted">No countries found</div>
                  </div>
                </div>
              </div>
              <input type="tel" x-model="formData.mobile" placeholder="9876543210" class="flex-1 p-4 bg-white border border-brand-border rounded-xl focus:border-brand-saffron focus:ring-2 focus:ring-brand-saffron/20 outline-none transition-all" :class="{'border-red-500': errors.mobile}">
            </div>
            <p x-show="errors.mobile" class="text-red-500 text-xs mt-1">Please enter your mobile number.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold text-brand-navy uppercase tracking-wider mb-2">Raasi (Moon Sign) <span class="text-brand-saffron">*</span></label>
            <select x-model="formData.raasi" class="w-full p-4 bg-white border border-brand-border rounded-xl focus:border-brand-saffron focus:ring-2 focus:ring-brand-saffron/20 outline-none transition-all appearance-none" :class="{'border-red-500': errors.raasi}">
              <option value="">Select your Raasi</option>
              <option value="Mesham">Mesham (மேஷம்) — Aries</option>
              <option value="Rishabam">Rishabam (ரிஷபம்) — Taurus</option>
              <option value="Midhunam">Midhunam (மிதுனம்) — Gemini</option>
              <option value="Kadagam">Kadagam (கடகம்) — Cancer</option>
              <option value="Simbha">Simbha (சிம்மம்) — Leo</option>
              <option value="Kanni">Kanni (கன்னி) — Virgo</option>
              <option value="Thulam">Thulam (துலாம்) — Libra</option>
              <option value="Vrichigam">Vrichigam (விருச்சிகம்) — Scorpio</option>
              <option value="Dhanusu">Dhanusu (தனுசு) — Sagittarius</option>
              <option value="Magaram">Magaram (மகரம்) — Capricorn</option>
              <option value="Kumbam">Kumbam (கும்பம்) — Aquarius</option>
              <option value="Meenam">Meenam (மீனம்) — Pisces</option>
            </select>
            <p x-show="errors.raasi" class="text-red-500 text-xs mt-1">Please select your Raasi.</p>
          </div>
          <div>
            <label class="block text-xs font-bold text-brand-navy uppercase tracking-wider mb-2">Lagnam (Ascendant) <span class="text-brand-saffron">*</span></label>
            <select x-model="formData.lagnam" class="w-full p-4 bg-white border border-brand-border rounded-xl focus:border-brand-saffron focus:ring-2 focus:ring-brand-saffron/20 outline-none transition-all appearance-none" :class="{'border-red-500': errors.lagnam}">
              <option value="">Select your Lagnam</option>
              <option value="Mesham">Mesham (மேஷம்)</option>
              <option value="Rishabam">Rishabam (ரிஷபம்)</option>
              <option value="Midhunam">Midhunam (மிதுனம்)</option>
              <option value="Kadagam">Kadagam (கடகம்)</option>
              <option value="Simbha">Simbha (சிம்மம்)</option>
              <option value="Kanni">Kanni (கன்னி)</option>
              <option value="Thulam">Thulam (துலாம்)</option>
              <option value="Vrichigam">Vrichigam (விருச்சிகம்)</option>
              <option value="Dhanusu">Dhanusu (தனுசு)</option>
              <option value="Magaram">Magaram (மகரம்)</option>
              <option value="Kumbam">Kumbam (கும்பம்)</option>
              <option value="Meenam">Meenam (மீனம்)</option>
            </select>
            <p x-show="errors.lagnam" class="text-red-500 text-xs mt-1">Please select your Lagnam.</p>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-brand-navy uppercase tracking-wider mb-2">Nakshatra (Birth Star) <span class="text-brand-saffron">*</span></label>
          <select x-model="formData.nakshatra" class="w-full p-4 bg-white border border-brand-border rounded-xl focus:border-brand-saffron focus:ring-2 focus:ring-brand-saffron/20 outline-none transition-all appearance-none" :class="{'border-red-500': errors.nakshatra}">
            <option value="">Select your Nakshatra</option>
            <option value="Ashwini">Ashwini (அஸ்வினி)</option>
            <option value="Bharani">Bharani (பரணி)</option>
            <option value="Karthikai">Karthikai (கார்த்திகை)</option>
            <option value="Rohini">Rohini (ரோகிணி)</option>
            <option value="Mrigashira">Mrigashira (மிருகசீரிடம்)</option>
            <option value="Ardra">Ardra / Thiruvadhirai (திருவாதிரை)</option>
            <option value="Punarvasu">Punarvasu / Punarpoosam (புனர்பூசம்)</option>
            <option value="Pushya">Pushya / Poosam (பூசம்)</option>
            <option value="Ashlesha">Ashlesha / Ayilyam (ஆயில்யம்)</option>
            <option value="Magha">Magha / Magam (மகம்)</option>
            <option value="Purva Phalguni">Purva Phalguni / Pooram (பூரம்)</option>
            <option value="Uttara Phalguni">Uttara Phalguni / Uthiram (உத்திரம்)</option>
            <option value="Hasta">Hasta / Astham (அஸ்தம்)</option>
            <option value="Chitra">Chitra / Chithirai (சித்திரை)</option>
            <option value="Swathi">Swathi / Swati (சுவாதி)</option>
            <option value="Vishakha">Vishakha / Visakam (விசாகம்)</option>
            <option value="Anuradha">Anuradha / Anusham (அனுஷம்)</option>
            <option value="Jyeshta">Jyeshta / Kettai (கேட்டை)</option>
            <option value="Mula">Mula / Moolam (மூலம்)</option>
            <option value="Purva Ashadha">Purva Ashadha / Pooradam (பூராடம்)</option>
            <option value="Uttara Ashadha">Uttara Ashadha / Uthiradam (உத்திராடம்)</option>
            <option value="Shravana">Shravana / Thiruvonam (திருவோணம்)</option>
            <option value="Dhanishta">Dhanishta / Avittam (அவிட்டம்)</option>
            <option value="Shatabhisha">Shatabhisha / Sadayam (சதயம்)</option>
            <option value="Purva Bhadrapada">Purva Bhadrapada / Poorattadhi (பூரட்டாதி)</option>
            <option value="Uttara Bhadrapada">Uttara Bhadrapada / Uthirattadhi (உத்திரட்டாதி)</option>
            <option value="Revathi">Revathi (ரேவதி)</option>
          </select>
          <p class="text-brand-text-muted text-xs mt-2">Tamil name shown in brackets. Select the one you know by either name.</p>
          <p x-show="errors.nakshatra" class="text-red-500 text-xs mt-1">Please select your Nakshatra.</p>
        </div>
      </div>
    </div>

    <!-- Step 2: Struggles -->
    <div x-show="step === 1 && !isComplete" x-transition.opacity.duration.300ms style="display: none;">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-2 text-xs">Step 2 of 6</div>
      <h2 class="text-4xl font-bold text-brand-navy mb-4">Current <span class="text-brand-saffron italic">struggles</span></h2>
      <p class="text-brand-text-muted mb-6 leading-relaxed max-w-2xl">What challenges are you facing right now? Select all that apply.</p>
      
      <div class="flex flex-wrap gap-3">
        <button type="button" @click="formData.struggles.length === struggleOpts.length ? formData.struggles = [] : formData.struggles = [...struggleOpts]" class="px-5 py-3 rounded-full border transition-all text-sm font-bold bg-brand-light-bg text-brand-navy border-brand-border hover:border-brand-saffron shadow-sm flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" x-show="formData.struggles.length === struggleOpts.length" style="display: none;"/><path d="M5 13l4 4L19 7" x-show="formData.struggles.length !== struggleOpts.length"/></svg>
          <span x-text="formData.struggles.length === struggleOpts.length ? 'Deselect All' : 'Select All'"></span>
        </button>
        <template x-for="opt in struggleOpts" :key="opt">
          <button type="button" @click="toggleArray('struggles', opt)" class="px-5 py-3 rounded-full border transition-all text-sm font-medium" :class="[
            formData.struggles.includes(opt) ? 'bg-brand-saffron text-white border-brand-saffron shadow-md' : 'bg-white border-brand-border text-brand-navy hover:border-brand-saffron'
          ]">
            <span x-text="opt"></span>
          </button>
        </template>
      </div>
      <p x-show="errors.struggles" class="text-red-500 text-xs mt-3">Please select at least one option.</p>
    </div>

    <!-- Step 3: Daily Life -->
    <div x-show="step === 2 && !isComplete" x-transition.opacity.duration.300ms style="display: none;">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-2 text-xs">Step 3 of 6</div>
      <h2 class="text-4xl font-bold text-brand-navy mb-4">Your daily <span class="text-brand-saffron italic">life</span></h2>
      <p class="text-brand-text-muted mb-6 leading-relaxed max-w-2xl">Which best describes your current daily rhythm and lifestyle?</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <template x-for="opt in dailyLifeOpts" :key="opt.label">
          <div @click="formData.dailyLife = opt.label" class="p-5 rounded-xl border cursor-pointer transition-all flex items-start gap-4" :class="formData.dailyLife === opt.label ? 'bg-brand-saffron/5 border-brand-saffron' : 'bg-white border-brand-border hover:border-brand-saffron/50'">
            <div class="w-5 h-5 rounded-full border-2 mt-0.5 flex-shrink-0 flex items-center justify-center transition-colors" :class="formData.dailyLife === opt.label ? 'border-brand-saffron' : 'border-brand-border'">
              <div class="w-2.5 h-2.5 rounded-full bg-brand-saffron transition-transform" :class="formData.dailyLife === opt.label ? 'scale-100' : 'scale-0'"></div>
            </div>
            <div>
              <div class="font-bold text-brand-navy text-base mb-1" x-text="opt.label"></div>
              <div class="text-brand-text-muted text-xs leading-relaxed" x-text="opt.sub"></div>
            </div>
          </div>
        </template>
      </div>
      <p x-show="errors.dailyLife" class="text-red-500 text-xs mt-3">Please select one option.</p>
    </div>

    <!-- Step 4: Goals -->
    <div x-show="step === 3 && !isComplete" x-transition.opacity.duration.300ms style="display: none;">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-2 text-xs">Step 4 of 6</div>
      <h2 class="text-4xl font-bold text-brand-navy mb-4">Your life <span class="text-brand-saffron italic">goals</span></h2>
      <p class="text-brand-text-muted mb-6 leading-relaxed max-w-2xl">What do you most want to achieve or experience in your life? Select all that apply.</p>
      
      <div class="flex flex-wrap gap-3">
        <button type="button" @click="formData.goals.length === goalOpts.length ? formData.goals = [] : formData.goals = [...goalOpts]" class="px-5 py-3 rounded-full border transition-all text-sm font-bold bg-brand-light-bg text-brand-navy border-brand-border hover:border-brand-saffron shadow-sm flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" x-show="formData.goals.length === goalOpts.length" style="display: none;"/><path d="M5 13l4 4L19 7" x-show="formData.goals.length !== goalOpts.length"/></svg>
          <span x-text="formData.goals.length === goalOpts.length ? 'Deselect All' : 'Select All'"></span>
        </button>
        <template x-for="opt in goalOpts" :key="opt">
          <button type="button" @click="toggleArray('goals', opt)" class="px-5 py-3 rounded-full border transition-all text-sm font-medium" :class="[
            formData.goals.includes(opt) ? 'bg-brand-saffron text-white border-brand-saffron shadow-md' : 'bg-white border-brand-border text-brand-navy hover:border-brand-saffron'
          ]">
            <span x-text="opt"></span>
          </button>
        </template>
      </div>
      <p x-show="errors.goals" class="text-red-500 text-xs mt-3">Please select at least one option.</p>
    </div>

    <!-- Step 5: Spiritual -->
    <div x-show="step === 4 && !isComplete" x-transition.opacity.duration.300ms style="display: none;">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-2 text-xs">Step 5 of 6</div>
      <h2 class="text-4xl font-bold text-brand-navy mb-4">Your spiritual <span class="text-brand-saffron italic">orientation</span></h2>
      <p class="text-brand-text-muted mb-6 leading-relaxed max-w-2xl">How would you describe your relationship with spirituality? This shapes the tone of your report.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <template x-for="opt in spiritualOpts" :key="opt.label">
          <div @click="formData.spiritual = opt.label" class="p-5 rounded-xl border cursor-pointer transition-all flex items-start gap-4" :class="formData.spiritual === opt.label ? 'bg-brand-saffron/5 border-brand-saffron' : 'bg-white border-brand-border hover:border-brand-saffron/50'">
            <div class="w-5 h-5 rounded-full border-2 mt-0.5 flex-shrink-0 flex items-center justify-center transition-colors" :class="formData.spiritual === opt.label ? 'border-brand-saffron' : 'border-brand-border'">
              <div class="w-2.5 h-2.5 rounded-full bg-brand-saffron transition-transform" :class="formData.spiritual === opt.label ? 'scale-100' : 'scale-0'"></div>
            </div>
            <div>
              <div class="font-bold text-brand-navy text-base mb-1" x-text="opt.label"></div>
              <div class="text-brand-text-muted text-xs leading-relaxed" x-text="opt.sub"></div>
            </div>
          </div>
        </template>
      </div>
      <p x-show="errors.spiritual" class="text-red-500 text-xs mt-3">Please select one option.</p>
    </div>

    <!-- Step 6: Review -->
    <div x-show="step === 5 && !isComplete" x-transition.opacity.duration.300ms style="display: none;">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-2 text-xs">Step 6 of 6</div>
      <h2 class="text-4xl font-bold text-brand-navy mb-4">Review your <span class="text-brand-saffron italic">details</span></h2>
      <p class="text-brand-text-muted mb-8 leading-relaxed max-w-2xl">Check everything below before generating your report. You can go back to edit any section.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="bg-white border border-brand-border rounded-xl p-4 shadow-sm relative">
          <button @click="step = 0" class="absolute top-4 right-4 text-brand-saffron text-xs font-semibold hover:underline">Edit</button>
          <div class="text-brand-saffron-dark text-[10px] tracking-widest uppercase mb-1">Name</div>
          <div class="font-bold text-brand-navy text-lg" x-text="formData.name"></div>
        </div>
        <div class="bg-white border border-brand-border rounded-xl p-4 shadow-sm relative">
          <button @click="step = 0" class="absolute top-4 right-4 text-brand-saffron text-xs font-semibold hover:underline">Edit</button>
          <div class="text-brand-saffron-dark text-[10px] tracking-widest uppercase mb-1">Raasi / Lagnam / Star</div>
          <div class="font-bold text-brand-navy text-base" x-text="`${formData.raasi} / ${formData.lagnam}`"></div>
          <div class="text-brand-text-muted text-sm mt-1" x-text="formData.nakshatra"></div>
        </div>
      </div>

      <div class="space-y-4 mb-8">
        <div class="bg-white border border-brand-border rounded-xl p-6 shadow-sm relative">
          <button @click="step = 1" class="absolute top-6 right-6 text-brand-saffron text-xs font-semibold hover:underline">Edit</button>
          <div class="text-brand-saffron-dark text-[10px] tracking-widest uppercase mb-4">Current Struggles</div>
          <div class="flex flex-wrap gap-2">
            <template x-for="s in formData.struggles" :key="s">
              <span class="bg-brand-saffron/10 text-brand-navy text-xs px-3 py-1.5 rounded-full border border-brand-saffron/20" x-text="s"></span>
            </template>
          </div>
        </div>
        <div class="bg-white border border-brand-border rounded-xl p-6 shadow-sm relative">
          <button @click="step = 2" class="absolute top-6 right-6 text-brand-saffron text-xs font-semibold hover:underline">Edit</button>
          <div class="text-brand-saffron-dark text-[10px] tracking-widest uppercase mb-2">Daily Life</div>
          <div class="font-bold text-brand-navy" x-text="formData.dailyLife"></div>
        </div>
        <div class="bg-white border border-brand-border rounded-xl p-6 shadow-sm relative">
          <button @click="step = 3" class="absolute top-6 right-6 text-brand-saffron text-xs font-semibold hover:underline">Edit</button>
          <div class="text-brand-saffron-dark text-[10px] tracking-widest uppercase mb-4">Life Goals</div>
          <div class="flex flex-wrap gap-2">
            <template x-for="g in formData.goals" :key="g">
              <span class="bg-brand-saffron/10 text-brand-navy text-xs px-3 py-1.5 rounded-full border border-brand-saffron/20" x-text="g"></span>
            </template>
          </div>
        </div>
        <div class="bg-white border border-brand-border rounded-xl p-6 shadow-sm relative">
          <button @click="step = 4" class="absolute top-6 right-6 text-brand-saffron text-xs font-semibold hover:underline">Edit</button>
          <div class="text-brand-saffron-dark text-[10px] tracking-widest uppercase mb-2">Spiritual Orientation</div>
          <div class="font-bold text-brand-navy" x-text="formData.spiritual"></div>
        </div>
      </div>

      <div class="mb-4">
        <label class="block text-sm font-bold text-brand-navy uppercase tracking-wider mb-3">Select Final Report Language <span class="text-brand-saffron">*</span></label>
        <div class="grid grid-cols-2 gap-4">
          <button type="button" @click="formData.language = 'English'" class="p-4 rounded-xl border-2 transition-all text-center font-bold" :class="formData.language === 'English' ? 'bg-brand-navy text-white border-brand-navy' : 'bg-white text-brand-navy border-brand-border hover:border-brand-navy/50'">English</button>
          <button type="button" @click="formData.language = 'Tamil'" class="p-4 rounded-xl border-2 transition-all text-center font-bold" :class="formData.language === 'Tamil' ? 'bg-brand-navy text-white border-brand-navy' : 'bg-white text-brand-navy border-brand-border hover:border-brand-navy/50'">Tamil (தமிழ்)</button>
        </div>
      </div>

    </div>

    <!-- Success State -->
    <div x-show="isComplete" style="display: none;" class="py-16 text-center" x-transition.opacity.duration.500ms>
      <div class="w-20 h-20 bg-green-50 text-green-600 border border-green-200 rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h2 class="text-4xl font-bold text-brand-navy mb-4">Your Reading is in Progress!</h2>
      <p class="text-xl text-brand-text mb-8">Thank you, <span class="font-bold text-brand-saffron-dark" x-text="formData.name"></span>. We have successfully received your details. Our AI engine is currently mapping your unique cosmic blueprint and writing your personalized Life Transformation Report. This deep analysis takes about 2 to 3 minutes.</p>
      <div class="max-w-lg mx-auto bg-slate-50 border border-brand-border rounded-2xl p-8 shadow-sm">
        <div class="w-16 h-16 bg-blue-50 text-brand-navy border border-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <p class="text-brand-text font-medium leading-relaxed">
          It will be delivered to <strong x-text="formData.email"></strong> very shortly.<br>
          <span class="text-brand-navy font-bold mt-3 mb-2 block">You can safely close this page. We'll email you the moment it's ready!</span>
          <span class="text-sm block text-brand-text-muted">(Don't forget to check your spam/junk folder just in case)</span>
        </p>
      </div>
      <div class="mt-12">
        <a href="/" class="px-8 py-4 bg-brand-navy text-white rounded-xl font-bold hover:bg-brand-saffron transition-colors inline-block shadow-md hover:shadow-lg">Return to Home</a>
      </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="mt-12 pt-8 border-t border-brand-border flex items-center justify-between" x-show="!isGenerating && !isComplete">
      <button @click="prevStep" x-show="step > 0" class="text-brand-text hover:text-brand-saffron font-semibold flex items-center gap-2 transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        Back
      </button>
      <div x-show="step === 0"></div> <!-- Spacer for flex-between -->

      <button @click="nextStep" x-show="step < 5" class="px-8 py-3.5 bg-brand-navy text-white rounded-xl font-bold hover:bg-brand-saffron transition-colors shadow-lg flex items-center gap-2" :disabled="isPaying" :class="{ 'opacity-70 cursor-wait': isPaying }">
        <span x-text="isPaying ? 'Securing Spot...' : 'Continue'"></span>
        <svg x-show="!isPaying" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <button @click="submit" x-show="step === 5" class="px-8 py-4 bg-brand-saffron text-white rounded-xl font-bold text-lg hover:scale-105 transition-transform shadow-[0_4px_15px_rgba(245,158,11,0.3)] flex items-center gap-2">
        ✦ Generate My Reading
      </button>
    </div>

    <!-- Full Screen Loading Overlay -->
    <div x-show="isGenerating" class="fixed inset-0 z-50 flex items-center justify-center bg-brand-navy/95 backdrop-blur-sm transition-opacity" style="display: none;">
      <div class="text-center px-6 max-w-md w-full">
        <div class="w-24 h-24 mx-auto mb-8 relative">
          <!-- Animated data rings -->
          <div class="absolute inset-0 rounded-full border-2 border-brand-saffron/20 animate-ping" style="animation-duration: 2s;"></div>
          <div class="absolute inset-2 rounded-full border border-brand-saffron/40 animate-spin" style="animation-duration: 3s;"></div>
          <div class="absolute inset-4 rounded-full border border-brand-saffron/60 animate-spin" style="animation-direction: reverse; animation-duration: 4s;"></div>
          <!-- Center star -->
          <div class="absolute inset-0 flex items-center justify-center text-brand-saffron text-4xl">✦</div>
        </div>
        <h3 class="text-2xl font-serif font-bold text-white mb-2">Initializing AI Engine</h3>
        <p class="text-brand-saffron/80 text-lg tracking-wide animate-pulse" x-text="loadingMessage"></p>
        <div class="mt-8 relative">
          <div class="flex justify-between text-xs text-white/70 mb-2 font-mono">
            <span>0%</span>
            <span x-text="generationProgress + '%'" class="text-brand-saffron font-bold text-sm">0%</span>
            <span>100%</span>
          </div>
          <div class="h-2 bg-white/10 rounded-full overflow-hidden">
            <div class="h-full bg-brand-saffron transition-all duration-300 ease-out" :style="`width: ${generationProgress}%`"></div>
          </div>
          <p class="text-white/50 text-xs mt-4">Securing your spot in the generation queue. Please do not close this window.</p>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
import Alpine from 'alpinejs';
import { countryList } from '../lib/countries.js';

document.addEventListener('alpine:init', () => {
  Alpine.data('readingForm', () => ({
    step: 0,
    stepLabels: ['Your Details', 'Current Struggles', 'Daily Life', 'Life Goals', 'Spiritual Orientation'],
    formData: {
      name: '', email: '', countryCode: '+91', mobile: '', language: 'English', raasi: '', lagnam: '', nakshatra: '',
      struggles: [], dailyLife: '', goals: [], spiritual: ''
    },
    errors: {
      name: false, email: false, mobile: false, raasi: false, lagnam: false, nakshatra: false,
      struggles: false, dailyLife: false, goals: false, spiritual: false
    },
    struggleOpts: ["Money / Debt", "Health anxiety", "Relationship stress", "Family pressure", "Career confusion", "Overthinking", "Lack of confidence", "Loneliness"],
    dailyLifeOpts: [
      { label: "Hectic", sub: "No fixed pattern, always busy" },
      { label: "Office job", sub: "Structured hours, 9–5 schedule" },
      { label: "Work from home", sub: "Remote work, flexible hours" },
      { label: "Entrepreneur", sub: "Running my own venture" },
      { label: "Student", sub: "Currently studying" }
    ],
    goalOpts: ["Financial stability", "Better relationships", "Career growth", "Inner peace", "Build confidence", "Recognition", "Independence", "Health improvement", "Spiritual growth"],
    spiritualOpts: [
      { label: "Hindu / Devotional", sub: "I practice or follow Hindu traditions" },
      { label: "Spiritual but not religious", sub: "I believe in higher energy but not ritual" },
      { label: "Practical only", sub: "I prefer grounded, realistic guidance" },
      { label: "Open to all", sub: "I am open to any and all perspectives" }
    ],

    countries: countryList,
    countrySearch: '',
    countryOpen: false,
    
    get filteredCountries() {
      if (!this.countrySearch) return this.countries;
      const s = this.countrySearch.toLowerCase();
      return this.countries.filter(c => c.name.toLowerCase().includes(s) || c.code.includes(s));
    },

    selectCountry(code) {
      this.formData.countryCode = code;
      this.countryOpen = false;
      this.countrySearch = '';
    },

    isGenerating: false,
    isComplete: false,
    loadingMessage: 'Initializing...',
    generationProgress: 0,
    generationInterval: null,
    reportText: '',
    hasPaid: false,
    isPaying: false,
    
    init() {
      // 1. Restore from sessionStorage if exists
      const saved = sessionStorage.getItem('astroraja_form_state');
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          if (parsed.formData) this.formData = { ...this.formData, ...parsed.formData };
          if (parsed.step !== undefined) this.step = parsed.step;
          if (parsed.hasPaid !== undefined) this.hasPaid = parsed.hasPaid;
          if (parsed.isSubmitted === true) this.isComplete = true;
        } catch(e) {}
      }

      // 2. Pre-fill Raasi from URL param if exists (overrides saved state)
      const params = new URLSearchParams(window.location.search);
      const r = params.get('raasi');
      if (r) this.formData.raasi = r;
      
      // 3. Save State Helper
      const saveState = () => {
        sessionStorage.setItem('astroraja_form_state', JSON.stringify({
          formData: this.formData,
          step: this.step,
          hasPaid: this.hasPaid,
          isSubmitted: this.isComplete
        }));
      };

      // 4. Watch for changes and auto-save
      this.$watch('step', saveState);
      this.$watch('hasPaid', saveState);
      this.$watch('formData', saveState, { deep: true });
      
      // Clear errors dynamically when user types/selects
      this.$watch('formData.name', (val) => { if(val.trim()) this.errors.name = false; });
      this.$watch('formData.email', (val) => { if(val.trim() && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) this.errors.email = false; });
      this.$watch('formData.mobile', (val) => { if(val.trim()) this.errors.mobile = false; });
      this.$watch('formData.raasi', (val) => { if(val) this.errors.raasi = false; });
      this.$watch('formData.lagnam', (val) => { if(val) this.errors.lagnam = false; });
      this.$watch('formData.nakshatra', (val) => { if(val) this.errors.nakshatra = false; });
      this.$watch('formData.struggles', (val) => { if(val.length > 0) this.errors.struggles = false; });
      this.$watch('formData.dailyLife', (val) => { if(val) this.errors.dailyLife = false; });
      this.$watch('formData.goals', (val) => { if(val.length > 0) this.errors.goals = false; });
      this.$watch('formData.spiritual', (val) => { if(val) this.errors.spiritual = false; });
    },

    toggleArray(field, val) {
      const idx = this.formData[field].indexOf(val);
      if (idx > -1) {
        this.formData[field].splice(idx, 1);
      } else {
        this.formData[field].push(val);
      }
    },

    validateStep() {
      let valid = true;
      if (this.step === 0) {
        this.errors.name = !this.formData.name.trim();
        this.errors.email = !this.formData.email.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.formData.email);
        this.errors.mobile = !this.formData.mobile.trim();
        this.errors.raasi = !this.formData.raasi;
        this.errors.lagnam = !this.formData.lagnam;
        this.errors.nakshatra = !this.formData.nakshatra;
        if (this.errors.name || this.errors.email || this.errors.mobile || this.errors.raasi || this.errors.lagnam || this.errors.nakshatra) valid = false;
      } else if (this.step === 1) {
        this.errors.struggles = this.formData.struggles.length === 0;
        if (this.errors.struggles) valid = false;
      } else if (this.step === 2) {
        this.errors.dailyLife = !this.formData.dailyLife;
        if (this.errors.dailyLife) valid = false;
      } else if (this.step === 3) {
        this.errors.goals = this.formData.goals.length === 0;
        if (this.errors.goals) valid = false;
      } else if (this.step === 4) {
        this.errors.spiritual = !this.formData.spiritual;
        if (this.errors.spiritual) valid = false;
      }
      return valid;
    },

    async initiatePayment() {
      if (!this.validateStep()) return;
      
      this.isPaying = true;
      let countryCode = 'IN';
      try {
        const geoResponse = await fetch('https://ipapi.co/json/');
        const geoData = await geoResponse.json();
        if (geoData.country_code) countryCode = geoData.country_code;
      } catch (e) {
        console.error("GeoIP failed, defaulting to IN", e);
      }

      try {
        const orderRes = await fetch('/api/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ countryCode })
        });
        const orderData = await orderRes.json();
        
        if (!orderRes.ok) {
          alert("Payment gateway error: " + (orderData.error || 'Unknown'));
          this.isPaying = false;
          return;
        }

        const options = {
          key: orderData.keyId,
          amount: orderData.amount,
          currency: orderData.currency,
          name: "Ask Astro Raja",
          description: "Life Transformation Report Assessment",
          order_id: orderData.orderId,
          prefill: {
            name: this.formData.name
          },
          theme: {
            color: "#1e1b4b"
          },
          handler: (response) => {
            this.hasPaid = true;
            this.isPaying = false;
            this.step++;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          },
          modal: {
            ondismiss: () => {
              this.isPaying = false;
            }
          }
        };
        const rzp = new window.Razorpay(options);
        rzp.on('payment.failed', function (response){
          alert("Payment Failed: " + response.error.description);
        });
        rzp.open();
      } catch (e) {
        console.error(e);
        alert("Network error. Please try again.");
        this.isPaying = false;
      }
    },

    nextStep() {
      if (this.validateStep()) {
        if (this.step === 0 && !this.hasPaid) {
          this.initiatePayment();
        } else if (this.step < 5) {
          this.step++;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }
    },

    prevStep() {
      if (this.step > 0) {
        this.step--;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    },

    async submit() {
      // Save data to localStorage for the report page to use
      localStorage.setItem('astroraja_user_data', JSON.stringify(this.formData));
      
      this.isGenerating = true;
      this.generationProgress = 0;
      this.loadingMessage = 'Connecting to Astro Raja AI...';
      
      try {
        const response = await fetch('/api/queue-reading', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(this.formData),
        });
        
        const result = await response.json();
        
        if (!response.ok || result.error) {
          throw new Error(typeof result.error === 'string' ? result.error : (result.message || 'Unknown error'));
        }
        
        // Immediately record that the request was successfully queued
        // If the user refreshes during the animation, they skip the form and go straight to the Success page
        sessionStorage.setItem('astroraja_form_state', JSON.stringify({
          formData: this.formData,
          step: this.step,
          hasPaid: this.hasPaid,
          isSubmitted: true
        }));

        // --- Simulated Loading Process (35 seconds) ---
        const messages = [
          'Analyzing your Vedic parameters...', 
          'Validating your core struggles and goals...', 
          'Connecting to Ask Astro Raja AI...',
          'Passing data into the deep analysis queue...', 
          'Securing your priority generation slot...',
          'Finalizing request initialization...'
        ];
        
        let msgIndex = 0;
        
        // Update messages every 5 seconds
        const msgInterval = setInterval(() => {
          if (msgIndex < messages.length - 1) {
            msgIndex++;
            this.loadingMessage = messages[msgIndex];
          }
        }, 5000);
        
        // Update progress bar over 35 seconds to reach 99%
        const durationMs = 35000; 
        const intervalMs = 250;
        const steps = durationMs / intervalMs;
        let currentStep = 0;
        
        this.generationInterval = setInterval(() => {
          currentStep++;
          // Ease-out curve so it slows down near the end
          const progress = Math.min(99, Math.floor(99 * (1 - Math.pow(1 - currentStep/steps, 2.5))));
          this.generationProgress = progress;
          
          if (currentStep >= steps) {
            clearInterval(this.generationInterval);
            clearInterval(msgInterval);
            
            // Finish up
            this.loadingMessage = 'Request queued successfully!';
            this.generationProgress = 100;
            
            // Wait 1 second at 100% before showing success page
            setTimeout(() => {
              this.isGenerating = false;
              this.isComplete = true;
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }, 1200);
          }
        }, intervalMs);
        
      } catch (err) {
        clearInterval(this.generationInterval);
        this.isGenerating = false;
        const errorMessage = err instanceof Error ? err.message : JSON.stringify(err);
        alert(`Error queuing report: ${errorMessage}`);
      }
    }
  }));
});

window.Alpine = Alpine;
Alpine.start();
</script>
