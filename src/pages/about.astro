---
import Layout from '../layouts/Layout.astro';
---

<Layout basePath="" title="About Us | PatternBreak">

  <!-- PAGE HEADER -->
  <section class="pt-32 pb-16 px-4 bg-brand-navy text-center">
    <div class="max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-brand-saffron text-xs sm:text-sm font-semibold tracking-wide uppercase mb-6">
        Our Positioning
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight leading-tight">
        We don't read your stars.<br/>
        <span class="text-brand-saffron italic">We read your patterns.</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-300 leading-relaxed font-medium">
        And we give you the exact system to rewrite them.
      </p>
    </div>
  </section>

  <!-- WHO THIS IS FOR / NOT FOR -->
  <section class="py-24 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-navy">Is this right for you?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- FOR YOU -->
        <div class="p-10 rounded-3xl bg-slate-50 border border-brand-border">
          <h3 class="text-2xl font-bold text-brand-navy mb-6 border-b-2 border-brand-saffron pb-3 inline-block">This IS for you if:</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-brand-saffron font-bold text-xl leading-none mt-0.5">✓</span>
              <span class="text-brand-navy font-medium">You're tired of generic self-help advice that doesn't stick.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-saffron font-bold text-xl leading-none mt-0.5">✓</span>
              <span class="text-brand-navy font-medium">You've tried everything but the same pattern keeps repeating.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-saffron font-bold text-xl leading-none mt-0.5">✓</span>
              <span class="text-brand-navy font-medium">You want a system designed for YOUR specific psychology, not a one-size-fits-all.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-saffron font-bold text-xl leading-none mt-0.5">✓</span>
              <span class="text-brand-navy font-medium">You're ready to hear uncomfortable truths about yourself.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-saffron font-bold text-xl leading-none mt-0.5">✓</span>
              <span class="text-brand-navy font-medium">You want a daily manual, not a one-time reading.</span>
            </li>
          </ul>
        </div>

        <!-- NOT FOR YOU -->
        <div class="p-10 rounded-3xl bg-brand-light-bg border border-brand-border/50">
          <h3 class="text-2xl font-bold text-brand-navy mb-6 border-b-2 border-slate-300 pb-3 inline-block">This is NOT for you if:</h3>
          <ul class="space-y-4 text-brand-text-muted">
            <li class="flex items-start gap-3">
              <span class="font-bold text-xl leading-none mt-0.5">×</span>
              <span>You want someone to predict your future or tell you what will happen.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="font-bold text-xl leading-none mt-0.5">×</span>
              <span>You're looking for lucky numbers, gemstone recommendations, or quick fixes.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="font-bold text-xl leading-none mt-0.5">×</span>
              <span>You only want to hear good things about yourself to stroke your ego.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="font-bold text-xl leading-none mt-0.5">×</span>
              <span>You are not willing to take daily action to change your reality.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FUTURE PRODUCTS -->
  <section class="py-24 px-4 bg-slate-50 border-t border-brand-border">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-4 text-sm">The Roadmap</div>
        <h2 class="text-3xl md:text-4xl font-bold text-brand-navy">What's coming next</h2>
        <p class="text-brand-text-muted text-lg mt-4 max-w-2xl mx-auto">We are building an entire suite of behavioral transformation systems.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-8 rounded-2xl border border-brand-border shadow-sm flex flex-col">
          <div class="w-12 h-12 bg-brand-saffron/10 rounded-xl flex items-center justify-center text-2xl mb-6">🤝</div>
          <h3 class="font-bold text-brand-navy text-xl mb-3">Relationship Dynamics</h3>
          <p class="text-sm text-brand-text mb-6 flex-grow">Understand exactly why you and your partner clash. We decode both blueprints to bridge the gap and stop the toxic loops.</p>
          <div class="text-xs font-bold uppercase tracking-wider text-brand-saffron-dark">In Development</div>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-brand-border shadow-sm flex flex-col">
          <div class="w-12 h-12 bg-brand-saffron/10 rounded-xl flex items-center justify-center text-2xl mb-6">🌱</div>
          <h3 class="font-bold text-brand-navy text-xl mb-3">Parenting Blueprint</h3>
          <p class="text-sm text-brand-text mb-6 flex-grow">How to raise your child based on THEIR specific behavioral blueprint, abandoning generic parenting advice for what actually works.</p>
          <div class="text-xs font-bold uppercase tracking-wider text-brand-saffron-dark">Coming Soon</div>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-brand-border shadow-sm flex flex-col">
          <div class="w-12 h-12 bg-brand-saffron/10 rounded-xl flex items-center justify-center text-2xl mb-6">⚖️</div>
          <h3 class="font-bold text-brand-navy text-xl mb-3">Health + Wealth System</h3>
          <p class="text-sm text-brand-text mb-6 flex-grow">An integrated daily system for optimizing your physical body and your financial habits, completely customized to your psychology.</p>
          <div class="text-xs font-bold uppercase tracking-wider text-brand-saffron-dark">Coming Soon</div>
        </div>
      </div>
    </div>
  </section>

</Layout>
