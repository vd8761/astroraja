---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astroraja - Developer Directory</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-brand-light-bg text-brand-text min-h-screen flex items-center justify-center p-4 font-sans">
    
    <div class="max-w-3xl w-full bg-white rounded-3xl p-10 shadow-xl border border-brand-border relative overflow-hidden">
      <!-- Decorative background -->
      <div class="absolute -right-20 -top-20 opacity-5 w-64 h-64 pointer-events-none">
        <svg viewBox="0 0 100 100" fill="currentColor" class="text-brand-saffron"><circle cx="50" cy="50" r="50"/></svg>
      </div>
      
      <div class="text-center mb-10 relative z-10">
        <h1 class="text-3xl font-bold text-brand-navy mb-2">Astroraja Preview Directory</h1>
        <p class="text-brand-text-muted">Select a version below to preview the changes.</p>
      </div>

      <div class="space-y-6 relative z-10">
        
        <h2 class="text-sm font-bold text-brand-saffron-dark tracking-widest uppercase mb-4 border-b border-brand-border pb-2">The 3 Homepages</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
          <a href="/v1" class="group block p-6 bg-slate-50 border border-brand-border rounded-2xl hover:border-brand-saffron hover:shadow-md transition-all text-center">
            <div class="w-12 h-12 rounded-full bg-brand-purple/10 text-brand-purple flex items-center justify-center mx-auto mb-4 font-bold text-xl group-hover:scale-110 transition-transform">V1</div>
            <h3 class="font-bold text-brand-navy mb-1">Version 1</h3>
            <p class="text-xs text-brand-text-muted">The pure interactive multi-step form.</p>
          </a>
          
          <a href="/v2" class="group block p-6 bg-slate-50 border border-brand-border rounded-2xl hover:border-brand-saffron hover:shadow-md transition-all text-center">
            <div class="w-12 h-12 rounded-full bg-brand-navy/10 text-brand-navy flex items-center justify-center mx-auto mb-4 font-bold text-xl group-hover:scale-110 transition-transform">V2</div>
            <h3 class="font-bold text-brand-navy mb-1">Version 2</h3>
            <p class="text-xs text-brand-text-muted">The pure marketing landing page.</p>
          </a>

          <a href="/v3" class="group block p-6 bg-brand-navy border border-brand-navy-light rounded-2xl hover:border-brand-saffron hover:shadow-lg transition-all text-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-purple/20 to-transparent"></div>
            <div class="relative z-10">
              <div class="w-12 h-12 rounded-full bg-brand-saffron text-white flex items-center justify-center mx-auto mb-4 font-bold text-xl group-hover:scale-110 transition-transform shadow-md">V3</div>
              <h3 class="font-bold text-white mb-1">Version 3</h3>
              <p class="text-xs text-white/70">The ultimate combined master page.</p>
            </div>
          </a>
        </div>

        <h2 class="text-sm font-bold text-brand-saffron-dark tracking-widest uppercase mb-4 border-b border-brand-border pb-2 mt-8">The 4 New Content Pages</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a href="/how-it-works" class="p-4 bg-slate-50 border border-brand-border rounded-xl hover:bg-slate-100 transition-colors text-center text-sm font-semibold text-brand-navy">
            How It Works
          </a>
          <a href="/raasi-guide" class="p-4 bg-slate-50 border border-brand-border rounded-xl hover:bg-slate-100 transition-colors text-center text-sm font-semibold text-brand-navy">
            Raasi Guide
          </a>
          <a href="/faq" class="p-4 bg-slate-50 border border-brand-border rounded-xl hover:bg-slate-100 transition-colors text-center text-sm font-semibold text-brand-navy">
            FAQ
          </a>
          <a href="/about" class="p-4 bg-slate-50 border border-brand-border rounded-xl hover:bg-slate-100 transition-colors text-center text-sm font-semibold text-brand-navy">
            About Us
          </a>
        </div>
        
      </div>
    </div>
  </body>
</html>
