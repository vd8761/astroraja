---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ask Astro Raja | Version Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-brand-light-bg text-brand-text min-h-screen flex items-center justify-center p-4">
    <div class="max-w-4xl w-full">
      <div class="text-center mb-12">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-brand-saffron mx-auto mb-6" viewBox="0 0 100 100" fill="currentColor">
          <circle cx="38" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="4.5" />
          <circle cx="38" cy="18" r="3.5" />
          <circle cx="38" cy="82" r="3.5" />
          <circle cx="8" cy="50" r="3.5" />
          <path d="M 38 38 Q 38 50 26 50 Q 38 50 38 62 Q 38 50 50 50 Q 38 50 38 38 Z" />
          <path d="M 64 20 C 84 20 94 38 94 50 C 94 62 84 80 64 80 C 76 74 80 62 80 50 C 80 38 76 26 64 20 Z" />
        </svg>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Select a Version to Review</h1>
        <p class="text-lg text-brand-text-muted">Explore the different variations of the Ask Astro Raja website.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Version 1 -->
        <a href="/v1/" class="bg-white border-2 border-brand-border hover:border-brand-saffron rounded-2xl p-8 transition-all hover:shadow-xl group flex flex-col items-center text-center">
          <div class="w-16 h-16 bg-brand-navy text-white rounded-full flex items-center justify-center text-2xl font-bold mb-6 group-hover:scale-110 transition-transform">1</div>
          <h2 class="text-xl font-bold text-brand-navy mb-3">V1: Current Version</h2>
          <p class="text-brand-text-muted text-sm">
            The polished, modern design featuring the newly written, highly-optimized marketing copy.
          </p>
          <div class="mt-6 px-6 py-2 bg-slate-100 rounded-full text-brand-navy text-sm font-semibold group-hover:bg-brand-saffron group-hover:text-white transition-colors">
            View Version 1
          </div>
        </a>

        <!-- Version 2 -->
        <a href="/v2/" class="bg-white border-2 border-brand-border hover:border-brand-saffron rounded-2xl p-8 transition-all hover:shadow-xl group flex flex-col items-center text-center">
          <div class="w-16 h-16 bg-brand-navy text-white rounded-full flex items-center justify-center text-2xl font-bold mb-6 group-hover:scale-110 transition-transform">2</div>
          <h2 class="text-xl font-bold text-brand-navy mb-3">V2: Hybrid</h2>
          <p class="text-brand-text-muted text-sm">
            The polished, modern design (V1 theme) but populated entirely with the original Claude-generated text.
          </p>
          <div class="mt-6 px-6 py-2 bg-slate-100 rounded-full text-brand-navy text-sm font-semibold group-hover:bg-brand-saffron group-hover:text-white transition-colors">
            View Version 2
          </div>
        </a>

        <!-- Version 3 -->
        <a href="/v3/" class="bg-white border-2 border-brand-border hover:border-brand-saffron rounded-2xl p-8 transition-all hover:shadow-xl group flex flex-col items-center text-center">
          <div class="w-16 h-16 bg-brand-navy text-white rounded-full flex items-center justify-center text-2xl font-bold mb-6 group-hover:scale-110 transition-transform">3</div>
          <h2 class="text-xl font-bold text-brand-navy mb-3">V3: Original Claude</h2>
          <p class="text-brand-text-muted text-sm">
            The original, unmodified HTML design and content directly from the Claude generation source.
          </p>
          <div class="mt-6 px-6 py-2 bg-slate-100 rounded-full text-brand-navy text-sm font-semibold group-hover:bg-brand-saffron group-hover:text-white transition-colors">
            View Version 3
          </div>
        </a>

      </div>
    </div>
  </body>
</html>
