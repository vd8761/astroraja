---
import '../styles/global.css';

// Form Data Options
const raasiOptions = ["Mesham", "Rishabam", "Mithunam", "Kadagam", "Simham", "Kanni", "Thulam", "Viruchigam", "Dhanusu", "Magaram", "Kumbam", "Meenam"];
const lagnamOptions = ["Mesham", "Rishabam", "Mithunam", "Kadagam", "Simham", "Kanni", "Thulam", "Viruchigam", "Dhanusu", "Magaram", "Kumbam", "Meenam"];
const struggleOptions = [
  "Money / Debt / Income instability", "Health anxiety / Fear", "Relationship / Marriage stress", 
  "Family pressure / Guilt", "Career confusion / No direction", "Overthinking / Analysis paralysis", 
  "Anger / Frustration / Impatience", "Lack of confidence / Self-doubt", "Loneliness / Feeling misunderstood", 
  "Emotional overwhelm / Sensitivity", "Commitment issues", "Work-life imbalance", "Feeling stuck / Life not moving"
];
const dailyLifeOptions = [
  "Hectic — no fixed pattern", "Office job — structured hours", "Work from home", 
  "Entrepreneur / Own business", "Homemaker / Family-focused", "Student", "Multiple roles / All of the above"
];
const goalOptions = [
  "Financial stability / Independence", "Better relationships / Marriage harmony", "Career growth / Find purpose", 
  "Inner peace / Stop overthinking", "Build confidence / Self-worth", "Recognition / Be valued", 
  "Independence / Freedom", "Health improvement", "Build a business / Grow income", "Spiritual growth"
];
const spiritualOptions = [
  "Hindu / Temple / Devotional", "Spiritual but not religious", "Practical — no spiritual angle needed", "Open to all / Mixed"
];
---

<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Astroraja - Personalized Astrology Guidance Report</title>
  <meta name="description" content="Discover what your Raasi, Lagnam, and Nakshatra reveal about your life path. Get a personalized astrology guidance report based on ancient spiritual wisdom." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="antialiased bg-brand-navy-dark text-brand-cream relative selection:bg-brand-purple-light selection:text-white">

  <!-- Fixed Background Glows -->
  <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-brand-purple-dark/40 blur-[120px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-brand-navy/60 blur-[120px]"></div>
    <img src="/images/cosmic_birth_chart_1779193390034.png" alt="" class="absolute top-0 w-full h-full object-cover opacity-5 mix-blend-screen" />
  </div>

  <!-- Header / Nav -->
  <header class="fixed w-full top-0 z-50 bg-brand-navy-dark/80 backdrop-blur-md border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a7 7 0 1 0 10 10"/></svg>
        <span class="text-xl font-bold tracking-wide text-white">Astroraja</span>
      </div>
      <a href="#form-section" class="hidden md:flex bg-brand-gold text-brand-navy-dark px-5 py-2 rounded-full font-semibold hover:bg-brand-gold-light transition-all shadow-[0_0_15px_rgba(251,191,36,0.3)]">
        Get My Report
      </a>
    </div>
  </header>

  <main class="pt-16">
    <!-- 1. Hero Section -->
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden px-4 py-20">
      <div class="absolute inset-0 z-0">
        <img src="/images/hero_moon_zodiac_1779193351110.png" alt="Moon and Zodiac Astrology" class="w-full h-full object-cover opacity-30 object-top mask-image-b" style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0)); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0));" />
      </div>
      
      <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-brand-gold-light text-sm font-medium mb-8 backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
          Personalized Spiritual Guidance
        </div>
        
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight md:leading-tight mb-6 text-white drop-shadow-xl">
          Discover What Your <span class="gradient-text block mt-2">Raasi, Lagnam & Nakshatra</span> Reveal About Your Life Path
        </h1>
        
        <p class="text-lg md:text-xl text-brand-cream/80 max-w-2xl mb-10 leading-relaxed font-light">
          Share your birth star, moon sign, current struggles, daily lifestyle, goals, and spiritual orientation. Get a personalized astrology-based guidance report without repeated follow-up questions.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a href="#form-section" class="w-full sm:w-auto px-8 py-4 bg-brand-gold text-brand-navy-dark rounded-xl font-bold text-lg hover:scale-105 transition-transform shadow-[0_0_20px_rgba(251,191,36,0.4)] flex items-center justify-center gap-2">
            Generate My Astro Report
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#how-it-works" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/15 text-white rounded-xl font-medium text-lg transition-colors border border-white/10 flex items-center justify-center backdrop-blur-sm">
            See How It Works
          </a>
        </div>
        
        <p class="mt-8 text-sm text-brand-cream/60 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
          Simple details. Personalized guidance. No complicated process.
        </p>
      </div>
    </section>

    <!-- 2. Problem Section -->
    <section class="py-20 px-4 bg-gradient-to-b from-brand-navy-dark to-brand-navy relative">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">Feeling Confused About Life, <br class="hidden md:block" />Career, Family or Future?</h2>
          <p class="text-brand-cream/70 text-lg">We all face phases where the path ahead seems unclear.</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {["Career confusion", "Family pressure", "Financial stress", "Marriage delay", "Health worries", "Mental stress", "Spiritual disconnect", "Unclear future direction"].map(problem => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 flex flex-col items-center text-center hover:bg-white/10 transition-colors group">
              <div class="w-12 h-12 rounded-full bg-brand-purple/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-gold-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <h3 class="font-medium text-white">{problem}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Solution Section -->
    <section class="py-24 px-4 relative overflow-hidden">
      <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1/3 opacity-20 pointer-events-none">
        <img src="/images/abstract_mandala_1779193425126.png" alt="" class="w-full h-auto animate-[spin_60s_linear_infinite]" />
      </div>
      
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12 relative z-10">
        <div class="w-full md:w-1/2 rounded-3xl overflow-hidden border border-white/10 relative group">
          <div class="absolute inset-0 bg-brand-purple-dark/20 group-hover:bg-transparent transition-colors z-10"></div>
          <img src="/images/indian_temple_lamp_1779193370073.png" alt="Indian Temple Lamp" class="w-full h-auto object-cover scale-105 group-hover:scale-100 transition-transform duration-700" />
        </div>
        
        <div class="w-full md:w-1/2">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
            <span class="gradient-text">One Message.</span><br />
            <span class="text-brand-purple-light">One Report.</span><br />
            Clear Guidance.
          </h2>
          <p class="text-xl text-brand-cream/80 mb-8 font-light leading-relaxed">
            Forget endless back-and-forth consultations. At Astroraja, users can send all their details in one simple form.
          </p>
          <div class="bg-brand-navy border border-brand-purple/30 rounded-2xl p-6 shadow-lg glow">
            <h4 class="text-brand-gold mb-3 font-semibold text-lg flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              What we analyze:
            </h4>
            <ul class="grid grid-cols-2 gap-3 text-sm md:text-base text-brand-cream/90">
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Name</li>
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Raasi / Moon Sign</li>
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Lagnam / Ascendant</li>
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Nakshatra / Birth Star</li>
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Current Struggles</li>
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Daily Life Pattern</li>
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Biggest Life Goals</li>
              <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-brand-gold rounded-full"></div> Spiritual Orientation</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. How It Works -->
    <section id="how-it-works" class="py-20 px-4 bg-brand-navy/50">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-bold text-center text-white mb-16">How Astroraja Works</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          {[
            { step: "1", title: "Enter basic astrology details", icon: "M12 2a7 7 0 1 0 10 10" },
            { step: "2", title: "Select your current life situation", icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" },
            { step: "3", title: "Submit your complete details", icon: "m22 2-7 20-4-9-9-4Z" },
            { step: "4", title: "Receive personalized Astro guidance report", icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" }
          ].map(item => (
            <div class="relative flex flex-col items-center text-center">
              <div class="w-16 h-16 rounded-2xl bg-brand-purple-dark border border-brand-purple text-brand-gold flex items-center justify-center text-2xl font-bold mb-6 shadow-[0_0_15px_rgba(124,58,237,0.3)] relative z-10">
                {item.step}
              </div>
              <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
              <!-- Connector line for desktop -->
              <div class="hidden md:block absolute top-8 left-[50%] w-full h-[1px] bg-gradient-to-r from-brand-purple to-transparent -z-0"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Form Section -->
    <section id="form-section" class="py-24 px-4 relative">
      <div class="absolute inset-0 z-0">
        <img src="/images/peaceful_moonlight_1779193406223.png" alt="Peaceful Moonlight" class="w-full h-full object-cover opacity-20 object-center" />
        <div class="absolute inset-0 bg-brand-navy-dark/80 backdrop-blur-[2px]"></div>
      </div>
      
      <div class="max-w-4xl mx-auto relative z-10">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Request Your Astroraja Report</h2>
          <p class="text-brand-cream/80">Provide your details once. Receive clear, actionable spiritual guidance.</p>
        </div>

        <div class="bg-brand-navy/80 backdrop-blur-xl border border-brand-purple/40 rounded-3xl p-6 md:p-10 shadow-2xl relative overflow-hidden">
          
          <form class="space-y-8" id="astro-main-form">
            
            <!-- STEP 1: BASIC DETAILS -->
            <div id="form-step-1" class="transition-all duration-500">
              <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
                <h3 class="text-xl font-bold text-brand-gold">Step 1: Birth Details</h3>
                <span class="text-sm text-brand-cream/50 font-mono">1/3</span>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="space-y-2">
                  <label class="block text-sm font-medium text-brand-cream">Full Name</label>
                  <input type="text" name="fullname" required placeholder="Enter your name" class="w-full bg-brand-navy-dark/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all placeholder:text-white/30" />
                </div>
                
                <!-- Nakshatra -->
                <div class="space-y-2">
                  <label class="block text-sm font-medium text-brand-cream">Nakshatra / Birth Star</label>
                  <input type="text" name="nakshatra" required placeholder="Example: Chitra 4th Padam, Karthikai" class="w-full bg-brand-navy-dark/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all placeholder:text-white/30" />
                </div>

                <!-- Raasi -->
                <div class="space-y-2">
                  <label class="block text-sm font-medium text-brand-cream">Raasi / Moon Sign</label>
                  <select name="raasi" required class="w-full bg-brand-navy-dark/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all appearance-none cursor-pointer">
                    <option value="" disabled selected>Select Raasi</option>
                    {raasiOptions.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                </div>

                <!-- Lagnam -->
                <div class="space-y-2">
                  <label class="block text-sm font-medium text-brand-cream">Lagnam / Ascendant</label>
                  <select name="lagnam" required class="w-full bg-brand-navy-dark/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all appearance-none cursor-pointer">
                    <option value="" disabled selected>Select Lagnam</option>
                    {lagnamOptions.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                </div>
              </div>

              <div class="mt-8">
                <button type="button" id="btn-proceed" class="w-full py-5 rounded-xl bg-gradient-to-r from-brand-gold to-brand-sandal text-brand-navy-dark font-bold text-lg hover:shadow-[0_0_25px_rgba(251,191,36,0.5)] transition-all flex justify-center items-center gap-2 group">
                  Proceed to Secure Payment
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              </div>
            </div>

            <!-- STEP 2: PAYMENT (Simulated) -->
            <div id="form-step-2" class="hidden transition-all duration-500">
              <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
                <h3 class="text-xl font-bold text-brand-gold">Step 2: Unlock Report</h3>
                <span class="text-sm text-brand-cream/50 font-mono">2/3</span>
              </div>
              
              <div class="bg-brand-navy-dark/60 rounded-2xl p-6 md:p-8 border border-brand-purple/30 text-center mb-8">
                <div class="w-16 h-16 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4 border border-green-500/30">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                </div>
                <h4 class="text-2xl font-bold text-white mb-2">Personalized Astro Report</h4>
                <p class="text-brand-cream/80 mb-6">Gain complete clarity on your life path, career, and relationships.</p>
                
                <div class="text-4xl font-extrabold text-brand-gold mb-6">₹499 <span class="text-lg text-white/40 line-through font-normal">₹1499</span></div>
                
                <button type="button" id="btn-pay" class="w-full py-4 rounded-xl bg-green-500 text-white font-bold text-lg hover:bg-green-600 transition-colors shadow-[0_0_20px_rgba(34,197,94,0.3)] flex justify-center items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  Pay Securely Now
                </button>
                <p class="mt-4 text-xs text-white/40 flex items-center justify-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  100% Safe & Secure Payments
                </p>
              </div>
              <button type="button" id="btn-back-1" class="text-sm text-brand-cream/60 hover:text-brand-gold transition-colors flex items-center justify-center gap-1 mx-auto w-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                Back to Details
              </button>
            </div>

            <!-- STEP 3: INTAKE QUESTIONS -->
            <div id="form-step-3" class="hidden transition-all duration-500">
              <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
                <h3 class="text-xl font-bold text-brand-gold flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                  Payment Successful!
                </h3>
                <span class="text-sm text-brand-cream/50 font-mono">3/3</span>
              </div>
              
              <p class="text-sm text-brand-cream/70 mb-6">Please answer these 4 simple questions so we can personalize your guidance perfectly.</p>
              
              <!-- Q1 Struggles -->
              <div class="space-y-3 mb-6">
                <label class="block text-sm font-medium text-brand-cream">Q1. What are your current struggles? <span class="text-brand-gold/60 text-xs font-normal">(Select all that apply)</span></label>
                <div class="flex flex-wrap gap-2">
                  {struggleOptions.map((opt, i) => (
                    <label class="cursor-pointer">
                      <input type="checkbox" class="peer sr-only" name="struggles" value={opt} />
                      <div class="px-4 py-2 rounded-full border border-white/10 bg-white/5 text-sm text-brand-cream/80 peer-checked:bg-brand-purple peer-checked:text-white peer-checked:border-brand-purple transition-all hover:bg-white/10">
                        {opt}
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Q2 Daily Life -->
              <div class="space-y-3 mb-6">
                <label class="block text-sm font-medium text-brand-cream">Q2. Describe your daily life pattern</label>
                <div class="flex flex-wrap gap-2">
                  {dailyLifeOptions.map((opt, i) => (
                    <label class="cursor-pointer">
                      <input type="radio" class="peer sr-only" name="dailylife" value={opt} />
                      <div class="px-4 py-2 rounded-full border border-white/10 bg-white/5 text-sm text-brand-cream/80 peer-checked:bg-brand-gold peer-checked:text-brand-navy-dark peer-checked:font-medium peer-checked:border-brand-gold transition-all hover:bg-white/10">
                        {opt}
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Q3 Goals -->
              <div class="space-y-3 mb-6">
                <label class="block text-sm font-medium text-brand-cream">Q3. What are your biggest life goals? <span class="text-brand-gold/60 text-xs font-normal">(Select all that apply)</span></label>
                <div class="flex flex-wrap gap-2">
                  {goalOptions.map((opt, i) => (
                    <label class="cursor-pointer">
                      <input type="checkbox" class="peer sr-only" name="goals" value={opt} />
                      <div class="px-4 py-2 rounded-full border border-white/10 bg-white/5 text-sm text-brand-cream/80 peer-checked:bg-brand-purple peer-checked:text-white peer-checked:border-brand-purple transition-all hover:bg-white/10">
                        {opt}
                      </div>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Q4 Spiritual -->
              <div class="space-y-3 mb-8">
                <label class="block text-sm font-medium text-brand-cream">Q4. What is your spiritual orientation?</label>
                <select class="w-full bg-brand-navy-dark/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all appearance-none cursor-pointer">
                  <option value="" disabled selected>Select orientation</option>
                  {spiritualOptions.map(opt => <option value={opt}>{opt}</option>)}
                </select>
              </div>

              <button type="submit" class="w-full py-5 rounded-xl bg-gradient-to-r from-brand-gold to-brand-sandal text-brand-navy-dark font-bold text-lg hover:shadow-[0_0_25px_rgba(251,191,36,0.5)] transition-all flex justify-center items-center gap-2 group">
                Generate My Personalized Astro Report
