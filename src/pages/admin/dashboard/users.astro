---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import sql from '../../../lib/db';

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

// Get total count for pagination
const countResult = await sql`SELECT COUNT(*) as total FROM users`;
const totalUsers = parseInt(countResult[0].total);
const totalPages = Math.ceil(totalUsers / limit);

const usersResult = await sql`
  SELECT u.*, 
    COALESCE(SUM(r.tokens_used), 0) as total_token_usage_history,
    (SELECT name FROM profiles WHERE user_id = u.id ORDER BY created_at ASC LIMIT 1) as profile_name,
    (SELECT raasi FROM profiles WHERE user_id = u.id ORDER BY created_at ASC LIMIT 1) as profile_raasi,
    (SELECT nakshatra FROM profiles WHERE user_id = u.id ORDER BY created_at ASC LIMIT 1) as profile_nakshatra
  FROM users u
  LEFT JOIN reports r ON u.id = r.user_id
  GROUP BY u.id
  ORDER BY u.created_at DESC 
  LIMIT ${limit} OFFSET ${offset}
`;
---

<AdminLayout title="Registered Users" activeTab="users">
  <div class="bg-white rounded-xl shadow-sm border border-brand-border overflow-hidden">
    <div class="px-6 py-4 border-b border-brand-border bg-slate-50">
      <h3 class="font-bold text-brand-navy">All Registered Users</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm whitespace-nowrap">
        <thead class="text-xs text-brand-text-muted uppercase bg-slate-50/50">
          <tr>
            <th class="px-6 py-3 font-medium tracking-wider">Mobile / Email</th>
            <th class="px-6 py-3 font-medium tracking-wider">Primary Profile</th>
            <th class="px-6 py-3 font-medium tracking-wider">Joined Date</th>
            <th class="px-6 py-3 font-medium tracking-wider">Platform</th>
            <th class="px-6 py-3 font-medium tracking-wider">Avail. Tokens</th>
            <th class="px-6 py-3 font-medium tracking-wider">Tokens Used</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-border/50">
          {usersResult.map(user => (
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4">
                <div class="font-bold text-brand-navy">{user.mobile_number ? `${user.country_code || ''} ${user.mobile_number}` : 'N/A'}</div>
                <div class="text-xs text-brand-text-muted">{user.email || 'No email'}</div>
              </td>
              <td class="px-6 py-4">
                <div class="font-bold text-brand-navy">{user.profile_name || 'N/A'}</div>
                {(user.profile_raasi || user.profile_nakshatra) && <div class="text-xs text-brand-text-muted">{user.profile_raasi || ''} {user.profile_nakshatra ? `• ${user.profile_nakshatra}` : ''}</div>}
              </td>
              <td class="px-6 py-4 text-brand-text-muted">{new Date(user.created_at).toLocaleString()}</td>
              <td class="px-6 py-4">
                {user.is_whatsapp_user ? (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-green-100 text-green-800">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                    WhatsApp
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 text-slate-700">
                    Web
                  </span>
                )}
              </td>
              <td class="px-6 py-4 text-green-600 font-bold">{user.wallet_balance || 0}</td>
              <td class="px-6 py-4 text-brand-navy font-bold">{user.total_token_usage_history}</td>
            </tr>
          ))}
          {usersResult.length === 0 && (
            <tr>
              <td colspan="7" class="px-6 py-10 text-center text-brand-text-muted">No users found.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
    
    <!-- Pagination Controls -->
    <div class="px-6 py-4 border-t border-brand-border bg-white flex items-center justify-between">
      <div class="text-sm text-brand-text-muted">
        Showing <span class="font-medium text-brand-navy">{totalUsers === 0 ? 0 : offset + 1}</span> to <span class="font-medium text-brand-navy">{Math.min(offset + limit, totalUsers)}</span> of <span class="font-medium text-brand-navy">{totalUsers}</span> users
      </div>
      <div class="flex items-center gap-2">
        {page > 1 ? (
          <a href={`?page=${page - 1}`} class="px-3 py-1 border border-brand-border rounded hover:bg-slate-50 text-sm font-medium text-brand-navy transition-colors">Previous</a>
        ) : (
          <span class="px-3 py-1 border border-brand-border/50 text-brand-text-muted/50 rounded text-sm font-medium cursor-not-allowed">Previous</span>
        )}
        <span class="px-3 py-1 text-sm font-medium text-brand-navy">Page {page} of {Math.max(totalPages, 1)}</span>
        {page < totalPages ? (
          <a href={`?page=${page + 1}`} class="px-3 py-1 border border-brand-border rounded hover:bg-slate-50 text-sm font-medium text-brand-navy transition-colors">Next</a>
        ) : (
          <span class="px-3 py-1 border border-brand-border/50 text-brand-text-muted/50 rounded text-sm font-medium cursor-not-allowed">Next</span>
        )}
      </div>
    </div>
  </div>
</AdminLayout>
