---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import sql from '../../../lib/db';

const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1');
const limit = 20;
const offset = (page - 1) * limit;

const [{ count }] = await sql`SELECT COUNT(*) FROM reports`;
const totalReports = parseInt(count);
const totalPages = Math.ceil(totalReports / limit);

const reportsResult = await sql`
  SELECT r.id, r.language, r.status, r.price_paid, r.currency, r.ip_address, r.created_at, r.tokens_used, p.name as profile_name
  FROM reports r
  LEFT JOIN profiles p ON r.profile_id = p.id
  ORDER BY r.created_at DESC 
  LIMIT ${limit} OFFSET ${offset}
`;
---

<AdminLayout title="AI Reports" activeTab="reports">
  <div class="bg-white rounded-xl shadow-sm border border-brand-border overflow-hidden">
    <div class="px-6 py-4 border-b border-brand-border bg-slate-50 flex justify-between items-center">
      <h3 class="font-bold text-brand-navy">All AI Reports</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm whitespace-nowrap">
        <thead class="text-xs text-brand-text-muted uppercase bg-slate-50/50">
          <tr>
            <th class="px-6 py-3 font-medium tracking-wider">Report ID</th>
            <th class="px-6 py-3 font-medium tracking-wider">Profile</th>
            <th class="px-6 py-3 font-medium tracking-wider">Status</th>
            <th class="px-6 py-3 font-medium tracking-wider">Language</th>
            <th class="px-6 py-3 font-medium tracking-wider">Paid</th>
            <th class="px-6 py-3 font-medium tracking-wider">Tokens Used</th>
            <th class="px-6 py-3 font-medium tracking-wider">Date</th>
            <th class="px-6 py-3 font-medium tracking-wider text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-border/50">
          {reportsResult.map(report => (
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 text-xs font-mono text-brand-text-muted truncate max-w-[100px]">{report.id}</td>
              <td class="px-6 py-4 text-brand-navy font-bold">{report.profile_name || 'Unknown'}</td>
              <td class="px-6 py-4">
                <span class={`px-2.5 py-1 text-xs font-medium rounded-md ${
                  report.status === 'completed' ? 'bg-green-100 text-green-800' :
                  report.status === 'processing' ? 'bg-blue-100 text-blue-800' :
                  report.status === 'failed' ? 'bg-red-100 text-red-800' :
                  'bg-yellow-100 text-yellow-800'
                }`}>
                  {report.status}
                </span>
              </td>
              <td class="px-6 py-4 capitalize">{report.language}</td>
              <td class="px-6 py-4 text-green-600 font-medium">
                {report.price_paid > 0 ? `${report.currency} ${report.price_paid}` : 'Free'}
              </td>
              <td class="px-6 py-4 text-brand-navy">{report.tokens_used || 0}</td>
              <td class="px-6 py-4 text-brand-text-muted">{new Date(report.created_at).toLocaleString()}</td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href={`/admin/report-preview/${report.id}`} target="_blank" class="px-2.5 py-1.5 text-xs font-medium bg-slate-100 text-brand-navy rounded hover:bg-slate-200 transition-colors" title="Preview Report">
                    <svg class="w-4 h-4 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                  </a>
                  <a href={`/api/admin/report-pdf?id=${report.id}`} target="_blank" class="px-2.5 py-1.5 text-xs font-medium bg-blue-50 text-blue-700 rounded hover:bg-blue-100 transition-colors" title="Download PDF">
                    <svg class="w-4 h-4 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                  </a>
                  <button @click={`sendEmail('${report.id}')`} class="px-2.5 py-1.5 text-xs font-medium bg-amber-50 text-amber-700 rounded hover:bg-amber-100 transition-colors" title="Send Email">
                    <svg class="w-4 h-4 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  </button>
                  <button onclick={`window.open('/admin/report-preview/${report.id}?print=1', '_blank')`} class="px-2.5 py-1.5 text-xs font-medium bg-gray-50 text-gray-700 rounded hover:bg-gray-200 transition-colors border border-gray-200" title="Print">
                    <svg class="w-4 h-4 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
          {reportsResult.length === 0 && (
            <tr>
              <td colspan="8" class="px-6 py-10 text-center text-brand-text-muted">No reports found.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <!-- Pagination Controls -->
    <div class="px-6 py-4 border-t border-brand-border bg-white flex items-center justify-between">
      <div class="text-sm text-brand-text-muted">
        Showing <span class="font-medium text-brand-navy">{totalReports === 0 ? 0 : offset + 1}</span> to <span class="font-medium text-brand-navy">{Math.min(offset + limit, totalReports)}</span> of <span class="font-medium text-brand-navy">{totalReports}</span> reports
      </div>
      <div class="flex items-center gap-2">
        {page > 1 ? (
          <a href={`?page=${page - 1}`} class="px-3 py-1 border border-brand-border rounded hover:bg-slate-50 text-sm font-medium text-brand-navy transition-colors">Previous</a>
        ) : (
          <span class="px-3 py-1 border border-brand-border/50 text-brand-text-muted/50 rounded text-sm font-medium cursor-not-allowed">Previous</span>
        )}
        <span class="px-3 py-1 text-sm font-medium text-brand-navy">Page {page} of {Math.max(totalPages, 1)}</span>
        {page < totalPages ? (
          <a href={`?page=${page + 1}`} class="px-3 py-1 border border-brand-border rounded hover:bg-slate-50 text-sm font-medium text-brand-navy transition-colors">Next</a>
        ) : (
          <span class="px-3 py-1 border border-brand-border/50 text-brand-text-muted/50 rounded text-sm font-medium cursor-not-allowed">Next</span>
        )}
      </div>
    </div>

  </div>

  <script is:inline>
    async function sendEmail(reportId) {
      if (!confirm('Are you sure you want to email this report to the user?')) return;
      
      const btn = event.currentTarget;
      const originalHtml = btn.innerHTML;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin inline-block" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
      btn.disabled = true;

      try {
        const res = await fetch('/api/admin/send-report-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ report_id: reportId })
        });
        
        const data = await res.json();
        if (res.ok) {
          alert('Email sent successfully!');
        } else {
          alert('Error: ' + (data.error || 'Failed to send email'));
        }
      } catch (err) {
        alert('Network error while sending email.');
      } finally {
        btn.innerHTML = originalHtml;
        btn.disabled = false;
      }
    }
  </script>
</AdminLayout>
