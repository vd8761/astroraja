---
import sql from '../../lib/db';

const { id } = Astro.params;

let report = null;
let error = null;
let alreadySubmitted = false;

if (!id) {
  error = "Invalid report link.";
} else {
  try {
    const rows = await sql`
      SELECT r.id, p.name 
      FROM reports r
      JOIN profiles p ON r.profile_id = p.id
      WHERE r.id = ${id}
    `;

    if (rows.length === 0) {
      error = "Report not found.";
    } else {
      report = rows[0];
      
      // Check if feedback already exists
      const existing = await sql`SELECT id FROM feedbacks WHERE report_id = ${id}`;
      if (existing.length > 0) {
        alreadySubmitted = true;
      }
    }
  } catch (err) {
    console.error(err);
    error = "A database error occurred.";
  }
}
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rate Your Reading | Astro Raja</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300..900&family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
  
  <!-- Alpine JS -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <style>
    body {
      font-family: 'Outfit', sans-serif;
    }
    h1, h2, h3, .font-serif {
      font-family: 'Lora', serif;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col items-center justify-center p-4">

  <div class="max-w-xl w-full bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-100">
    
    <!-- Header -->
    <div class="bg-[#1e1b4b] p-6 text-center border-b-4 border-amber-500 relative overflow-hidden">
      <!-- Decorative circles -->
      <div class="absolute -top-10 -right-10 w-32 h-32 bg-amber-500 rounded-full mix-blend-multiply filter blur-xl opacity-20"></div>
      <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-indigo-500 rounded-full mix-blend-multiply filter blur-xl opacity-20"></div>
      
      <h1 class="text-3xl font-bold text-white relative z-10 tracking-tight">Ask Astro Raja</h1>
    </div>

    <!-- Content -->
    <div class="p-8">
      
      {error ? (
        <div class="text-center py-10">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-100 text-red-500 mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-slate-800 mb-2">Oops!</h2>
          <p class="text-slate-600">{error}</p>
        </div>
      ) : alreadySubmitted ? (
        <div class="text-center py-10">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-100 text-amber-600 mb-6 shadow-inner">
            <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg>
          </div>
          <h2 class="text-3xl font-bold text-slate-800 mb-3">Thank You!</h2>
          <p class="text-lg text-slate-600">You have already submitted your feedback for this reading. We deeply appreciate your time.</p>
        </div>
      ) : (
        <div x-data="feedbackForm()" class="space-y-6">
          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-[#1e1b4b] mb-2">Hello, <span class="text-amber-500">{report.name}</span>!</h2>
            <p class="text-slate-600">It's been 24 hours since you received your Life Transformation Report. We would love to hear how it resonated with you.</p>
          </div>

          <!-- Rating Stars -->
          <div class="flex flex-col items-center">
            <p class="text-sm font-semibold text-slate-500 uppercase tracking-widest mb-3">How would you rate your reading?</p>
            <div class="flex items-center justify-center space-x-2">
              <template x-for="i in 5" :key="i">
                <button 
                  type="button" 
                  @click="rating = i"
                  @mouseenter="hoverRating = i"
                  @mouseleave="hoverRating = 0"
                  class="focus:outline-none transition-transform transform hover:scale-110 active:scale-95"
                >
                  <svg 
                    class="w-12 h-12 transition-colors duration-200" 
                    :class="(hoverRating >= i || (!hoverRating && rating >= i)) ? 'text-amber-400 drop-shadow-md' : 'text-slate-200'"
                    fill="currentColor" 
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </button>
              </template>
            </div>
            <!-- Dynamic Rating Text -->
            <div class="h-6 mt-2">
              <p x-show="rating === 0 && hoverRating === 0" class="text-sm text-slate-400 italic">Select a star rating</p>
              <p x-show="(hoverRating || rating) === 1" x-transition class="text-sm font-medium text-red-500">Not what I expected</p>
              <p x-show="(hoverRating || rating) === 2" x-transition class="text-sm font-medium text-orange-500">Could be better</p>
              <p x-show="(hoverRating || rating) === 3" x-transition class="text-sm font-medium text-amber-500">It was okay</p>
              <p x-show="(hoverRating || rating) === 4" x-transition class="text-sm font-medium text-emerald-500">Very insightful</p>
              <p x-show="(hoverRating || rating) === 5" x-transition class="text-sm font-medium text-[#1e1b4b]">Absolutely life-changing!</p>
            </div>
          </div>

          <!-- Message Textarea -->
          <div class="relative mt-6" x-show="rating > 0" x-transition.opacity.duration.300ms>
            <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">Tell us more about your experience (optional)</label>
            <textarea 
              id="message" 
              x-model="message" 
              rows="4" 
              class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 bg-slate-50 transition-colors resize-none"
              placeholder="What resonated with you the most? Did the reading provide the clarity you were seeking?"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-4" x-show="rating > 0" x-transition.opacity.duration.500ms>
            <button 
              @click="submit()" 
              :disabled="loading"
              class="w-full bg-[#1e1b4b] hover:bg-[#2d296b] text-white font-bold py-4 px-6 rounded-xl shadow-lg transition-all flex justify-center items-center relative overflow-hidden group"
            >
              <span x-show="!loading" class="relative z-10 flex items-center">
                Submit Feedback
                <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </span>
              <span x-show="loading" class="relative z-10 flex items-center">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                Sending...
              </span>
            </button>
            <p x-show="errorMessage" x-text="errorMessage" class="text-red-500 text-sm mt-3 text-center"></p>
          </div>

          <!-- Success Screen (Hidden by default) -->
          <div 
            x-show="success" 
            x-transition.opacity.duration.500ms
            class="absolute inset-0 bg-white z-20 flex flex-col items-center justify-center p-8 rounded-2xl"
            style="display: none;"
          >
            <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mb-6 text-green-500 shadow-inner">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h2 class="text-3xl font-bold text-[#1e1b4b] mb-3">Thank You!</h2>
            <p class="text-lg text-slate-600 text-center">Your feedback has been received. We wish you all the best on your spiritual journey!</p>
          </div>

        </div>
      )}
    </div>
  </div>

  <script define:vars={{ reportId: id }}>
    document.addEventListener('alpine:init', () => {
      Alpine.data('feedbackForm', () => ({
        rating: 0,
        hoverRating: 0,
        message: '',
        loading: false,
        success: false,
        errorMessage: '',

        async submit() {
          if (this.rating === 0) return;
          this.loading = true;
          this.errorMessage = '';

          try {
            const res = await fetch('/api/submit-feedback', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                report_id: reportId,
                rating: this.rating,
                message: this.message
              })
            });

            const data = await res.json();

            if (res.ok) {
              this.success = true;
            } else {
              this.errorMessage = data.error || 'Failed to submit feedback. Please try again.';
            }
          } catch (err) {
            this.errorMessage = 'A network error occurred.';
          } finally {
            this.loading = false;
          }
        }
      }))
    })
  </script>
</body>
</html>
