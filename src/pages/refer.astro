---
import Layout from '../layouts/Layout.astro';
const REWARD_TOKENS = import.meta.env.REFERRAL_REWARD_TOKENS || '10';
---

<Layout title="Refer & Earn | Ask Astro Raja" description="Share Ask Astro Raja with your friends and earn free tokens for accurate astrology readings.">
  <div class="max-w-4xl mx-auto px-4 py-12 md:py-20" x-data="referDashboard">
    <div class="bg-white rounded-3xl shadow-xl border border-brand-border/50 overflow-hidden">
      <!-- Header -->
      <div class="bg-gradient-to-r from-brand-navy to-brand-purple p-8 md:p-12 text-center text-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] mix-blend-overlay"></div>
        <div class="relative z-10">
          <h1 class="text-3xl md:text-5xl font-serif font-bold mb-4">Refer & Earn Tokens</h1>
          <p class="text-white/80 text-lg max-w-2xl mx-auto">Give your friends the gift of clarity. When they get their first reading, you earn {REWARD_TOKENS} tokens to unlock advanced reports!</p>
        </div>
      </div>

      <div class="p-8 md:p-12">
        <!-- Auth Check State -->
        <div x-show="isLoading" class="flex flex-col items-center justify-center py-12">
          <svg class="animate-spin h-10 w-10 text-brand-saffron mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-brand-text-muted font-medium">Loading your dashboard...</p>
        </div>

        <div x-show="!isAuthenticated && !isLoading" class="text-center py-12" style="display: none;">
          <h2 class="text-2xl font-bold text-brand-navy mb-4">Please Login to View Your Referral Code</h2>
          <p class="text-brand-text-muted mb-8">You need an account to refer friends and earn tokens.</p>
          <a href="/get-reading" class="px-8 py-3 bg-brand-navy text-white rounded-full font-bold hover:bg-brand-purple transition-colors shadow-lg">Login / Sign Up</a>
        </div>

        <!-- Dashboard Content -->
        <div x-show="isAuthenticated && !isLoading" style="display: none;">
          
          <!-- Your Link Section -->
          <div class="bg-brand-saffron/5 rounded-2xl p-6 md:p-8 border border-brand-saffron/20 text-center mb-10">
            <h3 class="text-sm font-bold text-brand-navy uppercase tracking-widest mb-4">Your Unique Link</h3>
            
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-xl mx-auto mb-6">
              <input type="text" readonly :value="getReferralLink()" class="w-full bg-white border border-brand-border p-4 rounded-xl text-center sm:text-left text-brand-navy font-mono text-sm focus:outline-none" id="referralLinkInput">
              <button @click="copyLink()" class="w-full sm:w-auto px-6 py-4 bg-brand-saffron text-white font-bold rounded-xl hover:bg-[#d97706] transition-colors flex items-center justify-center gap-2 whitespace-nowrap shadow-md">
                <span x-text="copyText">Copy Link</span>
                <svg x-show="copyText === 'Copy Link'" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" /><path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" /></svg>
                <svg x-show="copyText !== 'Copy Link'" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </button>
            </div>

            <div class="flex flex-wrap justify-center gap-3">
              <button @click="shareWhatsApp()" class="flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#25D366] text-white font-medium hover:bg-[#128C7E] transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Share on WhatsApp
              </button>
            </div>
            
            <p class="mt-4 text-xs text-brand-text-muted">Or ask them to enter code <span class="font-bold text-brand-navy" x-text="stats.referralCode"></span> when signing up.</p>
          </div>

          <!-- Stats Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
            <div class="bg-white border border-brand-border rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mb-4 text-blue-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
              </div>
              <p class="text-brand-text-muted text-sm font-medium uppercase tracking-wider mb-1">Friends Referred</p>
              <h4 class="text-4xl font-bold text-brand-navy" x-text="stats.friendsReferred">0</h4>
            </div>
            
            <div class="bg-white border border-brand-border rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="w-12 h-12 bg-brand-saffron/10 rounded-full flex items-center justify-center mb-4 text-brand-saffron">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <p class="text-brand-text-muted text-sm font-medium uppercase tracking-wider mb-1">Tokens Earned</p>
              <h4 class="text-4xl font-bold text-brand-navy" x-text="stats.tokensEarned">0</h4>
            </div>
          </div>

          <!-- How it Works Steps -->
          <h3 class="text-2xl font-serif font-bold text-brand-navy mb-6 text-center">How It Works</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 relative">
            <!-- connecting line for desktop -->
            <div class="hidden sm:block absolute top-10 left-[16.6%] right-[16.6%] h-0.5 bg-brand-border/60 z-0"></div>
            
            <div class="relative z-10 bg-white pt-2 sm:pt-4 text-center">
              <div class="w-12 h-12 bg-brand-navy text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 border-4 border-white shadow-sm">1</div>
              <h4 class="font-bold text-brand-navy mb-2">Share Link</h4>
              <p class="text-sm text-brand-text-muted">Send your unique link or code to your friends and family.</p>
            </div>
            
            <div class="relative z-10 bg-white pt-2 sm:pt-4 text-center">
              <div class="w-12 h-12 bg-brand-navy text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 border-4 border-white shadow-sm">2</div>
              <h4 class="font-bold text-brand-navy mb-2">They Sign Up</h4>
              <p class="text-sm text-brand-text-muted">They create an account and purchase their highly accurate reading.</p>
            </div>
            
            <div class="relative z-10 bg-white pt-2 sm:pt-4 text-center">
              <div class="w-12 h-12 bg-brand-saffron text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 border-4 border-white shadow-sm">3</div>
              <h4 class="font-bold text-brand-navy mb-2">You Earn</h4>
              <p class="text-sm text-brand-text-muted">You instantly get {REWARD_TOKENS} tokens added to your balance for each friend!</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('referDashboard', () => ({
        isLoading: true,
        isAuthenticated: false,
        copyText: 'Copy Link',
        stats: {
          referralCode: '',
          tokenBalance: 0,
          friendsReferred: 0,
          tokensEarned: 0
        },
        
        async init() {
          const token = localStorage.getItem('token');
          if (!token) {
            this.isLoading = false;
            this.isAuthenticated = false;
            return;
          }

          try {
            const response = await fetch('/api/user/referral-stats', {
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });
            
            const data = await response.json();
            if (response.ok && data.success) {
              this.stats = data;
              this.isAuthenticated = true;
            } else {
              // Token might be expired or invalid
              this.isAuthenticated = false;
            }
          } catch (e) {
            console.error('Error fetching stats:', e);
            this.isAuthenticated = false;
          } finally {
            this.isLoading = false;
          }
        },

        getReferralLink() {
          if (!this.stats.referralCode) return '';
          return `${window.location.origin}/?ref=${this.stats.referralCode}`;
        },

        copyLink() {
          const link = this.getReferralLink();
          const message = `I've been using Ask Astro Raja for deeply accurate astrology readings. Use my special link to get your own highly personalized report: ${link}`;
          
          navigator.clipboard.writeText(message).then(() => {
            this.copyText = 'Copied Message!';
            setTimeout(() => {
              this.copyText = 'Copy Link';
            }, 2000);
          });
        },

        shareWhatsApp() {
          const link = this.getReferralLink();
          const text = `I've been using Ask Astro Raja for deeply accurate astrology readings. Use my link to get your own highly personalized report: ${link}`;
          window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
        }
      }));
    });
  </script>
</Layout>
