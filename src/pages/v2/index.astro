---
import Layout from '../../layouts/Layout.astro';
---

<Layout basePath="/v2" title="Ask Astro Raja | Vedic Astrology Powered by AI">

  <!-- HERO SECTION -->
  <section class="py-24 px-4 bg-brand-light-bg text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-saffron/10 border border-brand-saffron/20 text-brand-saffron-dark text-xs sm:text-sm font-semibold tracking-wide uppercase mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-brand-saffron animate-pulse"></span>
        Vedic · AI-Powered · Personal
      </div>
      
      <h1 class="text-5xl sm:text-7xl font-extrabold text-brand-navy leading-[1.1] mb-8 tracking-tight">
        Your Stars <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-saffron to-brand-saffron-dark italic">Know Your Path.</span>
      </h1>
      
      <p class="text-lg md:text-xl text-brand-text max-w-2xl mx-auto leading-relaxed mb-10 font-medium">
        Share your Raasi, Lagnam and Nakshatra. In minutes, receive a deeply personal guidance report — rooted in authentic Vedic astrology, powered by AI.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <a href="/v2/get-reading" class="px-8 py-4 bg-brand-saffron text-white rounded-xl font-bold text-lg hover:scale-105 transition-transform shadow-[0_4px_15px_rgba(245,158,11,0.3)]">
          Begin Your Reading
        </a>
        <a href="/v2/how-it-works" class="font-semibold text-brand-navy hover:text-brand-saffron transition-colors flex items-center gap-2">
          See how it works
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7.5h9M8 3.5l4 4-4 4"/></svg>
        </a>
      </div>

      <div class="mt-16 pt-8 border-t border-brand-border/50 grid grid-cols-3 gap-4 max-w-2xl mx-auto text-brand-navy">
        <div><div class="text-3xl font-bold text-brand-saffron-dark">12K+</div><div class="text-sm font-medium">Readings Generated</div></div>
        <div><div class="text-3xl font-bold text-brand-saffron-dark">27</div><div class="text-sm font-medium">Nakshatras Covered</div></div>
        <div><div class="text-3xl font-bold text-brand-saffron-dark">4 min</div><div class="text-sm font-medium">Average Time</div></div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS PREVIEW -->
  <section class="py-24 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-4 text-sm">The Process</div>
      <h2 class="text-4xl md:text-5xl font-bold text-brand-navy mb-6">Three steps to your<br/><span class="text-brand-saffron italic">personal reading</span></h2>
      <p class="text-brand-text-muted text-lg max-w-2xl mx-auto">No waiting. No back-and-forth. Just your details and a report that speaks to your exact life situation right now.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-slate-50 border border-brand-border p-8 rounded-2xl relative">
        <span class="absolute top-4 right-6 text-5xl font-black text-brand-saffron/10">01</span>
        <div class="text-3xl mb-4 text-brand-saffron-dark">☽</div>
        <h3 class="text-xl font-bold text-brand-navy mb-3">Share Your Cosmic Identity</h3>
        <p class="text-brand-text-muted text-sm leading-relaxed">Enter your Raasi, Lagnam, and Nakshatra — the three pillars of your Vedic birth chart. These form the soul of your personalised reading.</p>
      </div>
      <div class="bg-slate-50 border border-brand-border p-8 rounded-2xl relative">
        <span class="absolute top-4 right-6 text-5xl font-black text-brand-saffron/10">02</span>
        <div class="text-3xl mb-4 text-brand-saffron-dark">◎</div>
        <h3 class="text-xl font-bold text-brand-navy mb-3">Answer Four Guided Questions</h3>
        <p class="text-brand-text-muted text-sm leading-relaxed">Tell us your current struggles, daily rhythm, life goals, and spiritual orientation. Simple inputs that give our AI the context to speak to your life — not a generic horoscope.</p>
      </div>
      <div class="bg-slate-50 border border-brand-border p-8 rounded-2xl relative">
        <span class="absolute top-4 right-6 text-5xl font-black text-brand-saffron/10">03</span>
        <div class="text-3xl mb-4 text-brand-saffron-dark">↓</div>
        <h3 class="text-xl font-bold text-brand-navy mb-3">Download Your Full Report</h3>
        <p class="text-brand-text-muted text-sm leading-relaxed">Within minutes, receive a full Vedic guidance report. Download as PDF or Word, share with family, and revisit whenever you need clarity.</p>
      </div>
    </div>
    <div class="mt-12 text-center">
      <a href="/v2/how-it-works" class="inline-flex items-center gap-2 font-semibold text-brand-saffron-dark hover:text-brand-navy transition-colors pb-1 border-b-2 border-brand-saffron-dark">
        Read the full process
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7.5h9M8 3.5l4 4-4 4"/></svg>
      </a>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-24 px-4 bg-slate-50 border-y border-brand-border">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-4 text-sm">Voices</div>
        <h2 class="text-4xl font-bold text-brand-navy">What our readers <span class="text-brand-saffron italic">say</span></h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 border border-brand-border rounded-2xl shadow-sm">
          <div class="text-6xl text-brand-saffron/20 font-serif leading-none h-8">"</div>
          <p class="text-brand-text-muted text-sm italic mb-8">I was confused about switching from IT to starting my own business. The report mapped my Lagnam's stance on risk beautifully — it gave me the confidence I had been waiting for.</p>
          <div class="flex items-center gap-4 border-t border-brand-border pt-4">
            <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=96&h=96&fit=crop&crop=top" class="w-12 h-12 rounded-full object-cover" alt="Karthik"/>
            <div>
              <div class="font-bold text-brand-navy text-sm">Karthik S.</div>
              <div class="text-xs text-brand-text-muted">Software Engineer, Chennai</div>
              <div class="text-xs font-semibold text-brand-saffron-dark mt-1">Simbha · Uthiram</div>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 border border-brand-border rounded-2xl shadow-sm">
          <div class="text-6xl text-brand-saffron/20 font-serif leading-none h-8">"</div>
          <p class="text-brand-text-muted text-sm italic mb-8">As a mother, I was worried about my daughter's direction. This report gave us something real to discuss — it connected astrology with practical, grounded steps forward.</p>
          <div class="flex items-center gap-4 border-t border-brand-border pt-4">
            <img src="https://images.unsplash.com/photo-1531123897727-8f129e1688ce?w=96&h=96&fit=crop&crop=top" class="w-12 h-12 rounded-full object-cover" alt="Meenakshi"/>
            <div>
              <div class="font-bold text-brand-navy text-sm">Meenakshi R.</div>
              <div class="text-xs text-brand-text-muted">Homemaker, Coimbatore</div>
              <div class="text-xs font-semibold text-brand-saffron-dark mt-1">Thulam · Swathi</div>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 border border-brand-border rounded-2xl shadow-sm">
          <div class="text-6xl text-brand-saffron/20 font-serif leading-none h-8">"</div>
          <p class="text-brand-text-muted text-sm italic mb-8">The section on my Nakshatra and commitment patterns was exact. I shared it with my partner and it opened a conversation we had never been able to have before.</p>
          <div class="flex items-center gap-4 border-t border-brand-border pt-4">
            <img src="https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=96&h=96&fit=crop&crop=top" class="w-12 h-12 rounded-full object-cover" alt="Priya"/>
            <div>
              <div class="font-bold text-brand-navy text-sm">Priya N.</div>
              <div class="text-xs text-brand-text-muted">Student, Madurai</div>
              <div class="text-xs font-semibold text-brand-saffron-dark mt-1">Meenam · Revathi</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="py-24 px-4 max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-16">
    <div class="w-full md:w-1/2 relative h-[500px]">
      <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=560&h=720&fit=crop&crop=top" class="w-[80%] h-[80%] object-cover rounded-2xl absolute bottom-0 left-0 shadow-lg" alt="Astro Raja"/>
      <img src="https://images.unsplash.com/photo-1621592484082-4b9d2a36e3b6?w=420&h=540&fit=crop&crop=top" class="w-[50%] h-[50%] object-cover rounded-2xl absolute top-0 right-0 border-8 border-white shadow-xl" alt="Consultation"/>
    </div>
    <div class="w-full md:w-1/2">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-4 text-sm">About</div>
      <h2 class="text-4xl md:text-5xl font-bold text-brand-navy mb-8">Vedic wisdom,<br/><span class="text-brand-saffron italic">reimagined</span></h2>
      
      <blockquote class="border-l-4 border-brand-saffron pl-4 italic text-xl text-brand-navy mb-8">
        "Astrology does not define your fate. It reveals the terrain — and you choose the path."
      </blockquote>
      
      <p class="text-brand-text-muted mb-4 leading-relaxed">Ask Astro Raja was built for the Tamil Nadu community — students, parents, working professionals — who seek clarity on career, relationships, and life direction through the lens of authentic Vedic astrology.</p>
      <p class="text-brand-text-muted mb-8 leading-relaxed">Unlike generic horoscope apps, every report here is generated using your exact Raasi, Lagnam, and Nakshatra combination, woven together with your personal context today.</p>
      
      <a href="/v2/about" class="inline-flex items-center gap-2 font-semibold text-brand-saffron-dark hover:text-brand-navy transition-colors pb-1 border-b-2 border-brand-saffron-dark">
        Our full story
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7.5h9M8 3.5l4 4-4 4"/></svg>
      </a>
    </div>
  </section>

</Layout>
