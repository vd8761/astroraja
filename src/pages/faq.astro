---
import Layout from '../layouts/Layout.astro';

const faqs = [
  { 
    q: "What exact details are needed for the report?", 
    a: "We simply need your Name, Raasi (Moon Sign), Lagnam (Ascendant), Nakshatra (Birth Star), and an understanding of your current life context through the 4 questions on our form." 
  },
  { 
    q: "Do I need to know my exact birth time?", 
    a: "If you already know your exact Raasi, Lagnam, and Nakshatra, you do not need to provide the exact birth time. Our system relies on these 3 crucial Vedic pillars." 
  },
  { 
    q: "How long does it take to get the report?", 
    a: "Because the report is generated by our custom-trained AI based on Vedic principles, your highly personalized PDF is generated and available to download within minutes of payment." 
  },
  { 
    q: "Is this suitable for career and marriage guidance?", 
    a: "Absolutely. The report covers major life themes including career direction, money blocks, marriage/relationship delays, and family dynamics." 
  },
  { 
    q: "Will I get spiritual remedies?", 
    a: "Yes. Depending on your answers to the spiritual orientation question, we include practical and temple-based spiritual remedies aligned with your specific Nakshatra and current planetary phases." 
  },
  { 
    q: "Is my personal data safe?", 
    a: "Yes. Your birth details and personal answers are used strictly for generating your one-time astrological report. We do not sell your data, and we do not store your payment information (which is handled securely by our payment processor)." 
  },
  { 
    q: "Is this only for Tamil astrology users?", 
    a: "While rooted in traditional Tamil/Vedic astrology concepts (Raasi, Lagnam, Nakshatra), the guidance is universally applicable and the final report is delivered in clear, modern English." 
  },
  {
    q: "Can I share this report with my family?",
    a: "Yes! Your report is generated as a beautifully formatted document that you can easily download, print, or share with family members or your local astrologer for further discussion."
  }
];


---

<Layout 
  title="FAQ | Ask Astro Raja"
  description="Have questions about how Ask Astro Raja works? Read our frequently asked questions about AI astrology, payment security, and what to expect in your report."
>
  
  <section class="py-24 px-4 bg-brand-light-bg relative overflow-hidden border-b border-brand-border/50">
    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <div class="text-brand-saffron-dark font-bold tracking-widest uppercase mb-4 text-sm">Support</div>
      <h1 class="text-5xl md:text-6xl font-extrabold leading-[1.1] mb-6 text-brand-navy">
        Frequently Asked <br />
        <span class="gradient-text-light">Questions.</span>
      </h1>
      <p class="text-xl text-brand-text max-w-xl mx-auto leading-relaxed">
        Everything you need to know about our astrological reports, the process, and your privacy.
      </p>
    </div>
  </section>

  <section class="py-20 px-4 bg-white min-h-[50vh]">
    <div class="max-w-3xl mx-auto">
      
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bg-slate-50 border border-brand-border rounded-xl group cursor-pointer overflow-hidden shadow-sm hover:shadow transition-shadow">
            <summary class="p-6 font-semibold text-lg text-brand-navy list-none flex justify-between items-center outline-none focus-visible:bg-slate-100">
              {faq.q}
              <span class="text-brand-saffron-dark group-open:rotate-180 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-brand-text text-base leading-relaxed border-t border-brand-border/30 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>

      <div class="mt-16 bg-brand-navy text-center p-10 rounded-2xl text-white">
        <h3 class="text-2xl font-bold mb-4">Still have questions?</h3>
        <p class="text-white/80 mb-6">If you couldn't find the answer you were looking for, feel free to reach out to our team.</p>
        <a href="mailto:contact@ask-astro-raja.com" class="inline-block px-8 py-3 bg-brand-saffron text-white rounded-lg font-semibold hover:bg-brand-saffron-dark transition-colors">
          Contact Support
        </a>
      </div>

    </div>
  </section>

</Layout>
