---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Affiliate Portal Login | Ask Astro Raja</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-brand-light-bg min-h-screen flex flex-col font-sans">
  
  <nav class="bg-white border-b border-brand-border sticky top-0 z-10 w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-brand-navy text-brand-saffron rounded flex items-center justify-center font-bold font-serif">AR</div>
          <span class="font-bold text-xl font-serif text-brand-navy">Ask Astro Raja</span>
        </div>
        <div>
          <span class="text-sm font-bold text-brand-saffron uppercase tracking-widest bg-brand-saffron/10 px-3 py-1 rounded-full border border-brand-saffron/20">Affiliate Portal</span>
        </div>
      </div>
    </div>
  </nav>

  <div class="flex-grow flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-lg border border-brand-border p-8" x-data="affiliateLogin">
      
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-brand-navy font-serif">Affiliate Login</h1>
        <p class="text-brand-text-muted mt-2">Enter your credentials to access the dashboard</p>
      </div>

      <form @submit.prevent="submitForm">
        <div class="mb-6">
          <label class="block text-sm font-bold text-brand-navy mb-2">Email or Mobile Number</label>
          <input 
            type="text" 
            x-model="identifier"
            class="w-full px-4 py-3 rounded-lg border border-brand-border focus:ring-2 focus:ring-brand-navy focus:border-brand-navy outline-none transition-all"
            placeholder="john@example.com"
            required
          >
        </div>

        <div class="mb-6">
          <label class="block text-sm font-bold text-brand-navy mb-2">Password</label>
          <input 
            type="password" 
            x-model="password"
            class="w-full px-4 py-3 rounded-lg border border-brand-border focus:ring-2 focus:ring-brand-navy focus:border-brand-navy outline-none transition-all"
            placeholder="••••••••"
            required
          >
          <p x-show="errorMsg" x-text="errorMsg" class="text-red-500 text-sm mt-2 font-medium" style="display: none;"></p>
        </div>

        <button 
          type="submit" 
          :disabled="isSubmitting"
          class="w-full bg-brand-navy text-white font-bold py-3 px-4 rounded-lg hover:bg-brand-saffron hover:text-brand-navy transition-colors disabled:opacity-70 flex justify-center shadow-md"
        >
          <span x-show="!isSubmitting">Secure Login</span>
          <span x-show="isSubmitting" style="display: none;">
            <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          </span>
        </button>
      </form>
      
    </div>
  </div>

  <script is:inline>
    // Check if already logged in
    if (localStorage.getItem('affiliate_token')) {
      window.location.href = '/affiliate/dashboard';
    }

    document.addEventListener('alpine:init', () => {
      Alpine.data('affiliateLogin', () => ({
        identifier: '',
        password: '',
        errorMsg: '',
        isSubmitting: false,

        async submitForm() {
          this.errorMsg = '';
          this.isSubmitting = true;
          
          try {
            const isEmail = this.identifier.includes('@');
            const payload = {
              password: this.password,
              email: isEmail ? this.identifier : undefined,
              mobile_number: !isEmail ? this.identifier : undefined
            };

            const res = await fetch('/api/affiliate/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            
            const data = await res.json();
            
            if (res.ok && data.success) {
              localStorage.setItem('affiliate_token', data.token);
              localStorage.setItem('affiliate_name', data.name);
              localStorage.setItem('affiliate_refcode', data.referral_code);
              window.location.href = '/affiliate/dashboard';
            } else {
              this.errorMsg = data.error || 'Invalid credentials';
              this.password = '';
            }
          } catch (err) {
            this.errorMsg = 'Network error. Please try again.';
          } finally {
            this.isSubmitting = false;
          }
        }
      }));
    });
  </script>
</body>
</html>
